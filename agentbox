#!/data/data/com.termux/files/usr/bin/bash
# Version — single source of truth; the installer greps ^VERSION= (keep the line bare, no trailing comment).
VERSION=3.25.0
# agentbox — throwaway, folder-scoped AI-agent boxes for a phone (Android Termux + proot-distro ONLY).
#
# THREAT MODEL: this protects YOUR FILES from *accidents* (an agent touching the wrong folder), not from a hostile
# agent. proot is same-UID path-rewriting, not a security boundary. Each box is a proot-distro container built from a
# profile: it binds only ONE folder (the cwd), injects only the tokens the profile lists, and can be thrown away and
# rebuilt reproducibly. Network is shared with the phone (no VPN — use a whole-device Android VPN app for a new exit IP).
SELF="${BASH_SOURCE[0]}"; command -v readlink >/dev/null && SELF=$(readlink -f "$SELF")
D=$(cd "$(dirname "$SELF")" && pwd)
# Ensure a UTF-8 locale: dw's width math counts "characters" via ${#s}, not bytes.
case "${LC_ALL:-${LANG:-}}" in *[Uu][Tt][Ff]*) :;; *)
  if locale -a 2>/dev/null | grep -qi '^C\.utf'; then export LC_ALL=C.UTF-8
  elif locale -a 2>/dev/null | grep -qi 'en_US\.utf'; then export LC_ALL=en_US.UTF-8; fi;; esac

# ── Settings / constants ───────────────────────────────────────────
# XDG dirs: config/secrets in ~/.config/agentbox, runtime/state in ~/.local/state/agentbox. Overridable.
CFG="${AGENTBOX_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/agentbox}"
STATE="${AGENTBOX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/agentbox}"
# Shipped box-profile templates live next to the script ($D/templates).
TPL="${AGENTBOX_TEMPLATES:-$D/templates}"
# Box distro: a profile's DIST= overrides for that box > env AGENTBOX_DIST > agent.env's AGENTBOX_DIST= > debian.
DIST="${AGENTBOX_DIST:-$(sed -n 's/^AGENTBOX_DIST=//p' "$CFG/agent.env" 2>/dev/null | head -1)}"; DIST="${DIST:-debian}"
PDLIB="$PREFIX/var/lib/proot-distro"
# rootfs path varies by proot-distro version: newer containers/<name>/rootfs, older installed-rootfs/<name>.
pdroot(){ local n="${1:-$DIST}" d; for d in "$PDLIB/containers/$n/rootfs" "$PDLIB/installed-rootfs/$n"; do
    [ -d "$d" ] && { echo "$d"; return; }; done
  d=$(find "$PDLIB" -maxdepth 3 -type d -name "$n" 2>/dev/null | head -1)
  [ -z "$d" ] && return 0; [ -d "$d/rootfs" ] && echo "$d/rootfs" || echo "$d"; }
VC="$CFG"; ENVF="$VC/agent.env"   # secrets file: host-side, mode 600, values injected per-profile (never the file itself).
GUI_BOXWEB=6902; GUI_BOXCODE=8081   # a DESKTOP= box's scoped KasmVNC + code-server ports (localhost).
GUI_BOXRFB=5901                     # …and its plain-VNC port when RFB=1 (native viewers; localhost unless LAN=1).
AGBASE="${AGENTBOX_BASE:-https://raw.githubusercontent.com/harryngai/agentbox/main}"   # installer base (ab update).
RCONF="$VC/rclone.conf"; RREMOTE="${AGENTBOX_REMOTE:-dropbox}"; RFILTER="$VC/rclone-filter.txt"   # sync (rclone bisync).

# ── Small helpers: output / detection ──────────────────────────────
if [ -t 1 ] && [ -z "$NO_COLOR" ]; then G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; Z=$'\e[0m'; BD=$'\e[1m'; CY=$'\e[36m'; DM=$'\e[2m'
  else G=; Y=; R=; Z=; BD=; CY=; DM=; fi
msg(){ printf '%s%s%s\n' "${2:-}" "$1" "$Z"; }
has(){ command -v "$1" >/dev/null 2>&1; }
# Display width: non-ASCII (CJK/fullwidth) counts as 2 cells — mixed CJK/ASCII alignment is computed, not hand-spaced.
dw(){ local s="$1" w=0 i ch; for ((i=0;i<${#s};i++)); do ch=${s:i:1}
  case "$ch" in
    ▸|▹|·|•|→|←|↑|↓|✓|✗|⇄) w=$((w+1));;
    [!$'\x01'-$'\x7f']) w=$((w+2));;
    *) w=$((w+1));;
  esac; done; echo $w; }
# Word-wrap $2 to the terminal, hanging every continuation line under a $1-column indent. Widths come from dw(), so a
# '·' or '→' costs the one cell it prints. Without this the long ▍Notes lines wrapped back to column 0 on a phone and
# the block stopped reading as a list. Globbing is off while splitting: the text carries paths and '*' is not a glob here.
wrap(){ local ind="$1" w word ww line= lw=0 out= pad g=; case $- in *f*) g=1;; esac; set -f
  pad=$(printf '%*s' "$ind" ''); w=$(( ${cols:-80} - ind )); [ "$w" -lt 24 ] && w=24
  for word in $2; do ww=$(dw "$word")
    if [ -z "$line" ]; then line="$word"; lw=$ww
    elif [ $((lw + 1 + ww)) -le "$w" ]; then line="$line $word"; lw=$((lw + 1 + ww))
    else out="$out$line"$'\n'"$pad"; line="$word"; lw=$ww; fi
  done
  [ -n "$g" ] || set +f; printf '%s%s' "$out" "$line"; }
kv(){ local n=$((20-$(dw "$1"))); ((n<0)) && n=0
  printf '%s%*s: %s%s%s\n' "$1" "$n" '' "${3:-}" "$2" "$Z"; }
# Status row (boxls): 2-space indent, bold key, no colon — aligns with the help's row() so bare `ab` reads as one doc.
st(){ local n=$((11-$(dw "$1"))); ((n<1)) && n=1
  printf '  %s%s%s%*s%s%s%s\n' "$BD" "$1" "$Z" "$n" '' "${3:-}" "$2" "$Z"; }
short(){ local p="$1"; case "$p" in "$HOME"|"$HOME"/*) p="~${p#"$HOME"}";;
    "${PREFIX:-//}"/*) p="\$PREFIX${p#"$PREFIX"}";; esac; printf '%s\n' "$p"; }
# All of the phone's IPv4 addresses (LAN-like first), minus loopback — for the ssh hint printed by setup.
lanips(){ local all
  all=$( { ip -4 -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1
           ifconfig 2>/dev/null | grep -oE 'inet (addr:)?[0-9.]+' | grep -oE '[0-9]+(\.[0-9]+){3}'
           has termux-wifi-connectioninfo && termux-wifi-connectioninfo 2>/dev/null | sed -n 's/.*"ip"[": ]*\([0-9.]\{1,\}\).*/\1/p'
         } | grep -vE '^127\.' | awk 'NF&&!s[$0]++' )
  [ -n "$all" ] || return 0
  { printf '%s\n' "$all" | grep -E '^192\.168\.'
    printf '%s\n' "$all" | grep -E '^172\.(1[6-9]|2[0-9]|3[01])\.'
    printf '%s\n' "$all" | grep -vE '^(192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)'; } | awk 'NF&&!s[$0]++' | paste -sd' ' -; }

# ── agent.env (tokens) ─────────────────────────────────────────────
# Ensure the env file exists and carries the standard keys (add any it is missing). Only the keys a profile's TOKENS
# lists are ever injected — %q-quoted into a 0600 file, sourced-then-deleted inside the box, never on argv.
mkenv(){ mkdir -p "$VC"
  [ -f "$ENVF" ] || printf '# agent tokens (mode 600; only the keys a profile lists in TOKENS are injected into its box)\n' > "$ENVF"
  local k; for k in CLAUDE_CODE_OAUTH_TOKEN OPENAI_API_KEY GEMINI_API_KEY GH_TOKEN \
      CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID OLLAMA_API_KEY AGENTBOX_DIST; do
    grep -q "^$k=" "$ENVF" || printf '%s=\n' "$k" >> "$ENVF"; done
  chmod 600 "$ENVF"; }
# Only the listed token keys, read from agent.env and %q-quoted (sourced then deleted inside the box, never on argv).
aboxenv(){ local keys="$1" k v; printf 'CLAUDE_CONFIG_DIR=/root/.claude\n'
  for k in $keys; do v=$(sed -n "s/^$k=//p" "$ENVF" 2>/dev/null | head -1)
    [ -n "$v" ] && printf '%s=%q\n' "$k" "$v"; done; }
# Edit agent.env item by item: show the current value, Enter keeps it, typing overwrites; append new vars at the end.
envedit(){ mkenv
  local tty="${AGENTBOX_TTY:-/dev/tty}" tmp line k v show nv extra; tmp=$(mktemp)
  msg "editing $ENVF (Enter = keep current value)" "$G"
  exec 3< "$tty"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) printf '%s\n' "$line" >> "$tmp";;
      *=*) k="${line%%=*}"; v="${line#*=}"
        if [ -z "$v" ]; then show="(empty)"
        elif [ ${#v} -gt 14 ]; then show="${v:0:10}…(${#v} chars)"
        else show="$v"; fi
        printf '  %s [%s]: ' "$k" "$show" >&2
        IFS= read -r nv <&3 || nv=""
        printf '%s=%s\n' "$k" "${nv:-$v}" >> "$tmp";;
      *) printf '%s\n' "$line" >> "$tmp";;
    esac
  done < "$ENVF"
  while :; do
    printf '  add KEY=VALUE (Enter to finish): ' >&2
    IFS= read -r extra <&3 || extra=""
    [ -z "$extra" ] && break
    case "$extra" in *=*) printf '%s\n' "$extra" >> "$tmp";; *) msg "  format must be KEY=VALUE" "$Y";; esac
  done
  exec 3<&-
  chmod 600 "$tmp" && mv "$tmp" "$ENVF"
  msg "updated $ENVF" "$G"; }

# ── Boxes / profiles ───────────────────────────────────────────────
# A box is a proot-distro container built from a profile (<name>.conf): it installs only what INSTALL lists, binds
# ONLY the launch folder (as /work-<kebab(cwd)>, unique per host folder so concurrent agents don't collide), and injects
# ONLY the tokens TOKENS lists. `ab <name>` from a folder builds the box if missing and runs it there. Profiles are just
# files: your editable copy at $VC/profile/<name>.conf, seeded from $TPL/<name>.conf (same filename, no box- prefix).
aboxconf(){ echo "$VC/profile/$1.conf"; }
# One-time migration: profiles used to live at $VC/box-<name>.conf; move any into $VC/profile/<name>.conf. Cheap no-op
# once done (the glob matches nothing). Snapshots stay as $STATE/box-snapshot-<name>.tar.gz — only the conf moved.
migrateconf(){ local f b; for f in "$VC"/box-*.conf; do [ -e "$f" ] || return 0
    mkdir -p "$VC/profile"; b=$(basename "$f" .conf); b=${b#box-}
    [ -e "$VC/profile/$b.conf" ] || mv "$f" "$VC/profile/$b.conf"; done; }
aboxalias(){ echo "agentbox-$1"; }   # proot container prefix (agentbox-<name>); tmux sessions use the shorter ab- prefix
aboxtemplates(){ local f b out=; for f in "$TPL"/*.conf; do [ -e "$f" ] || break
    b=$(basename "$f" .conf); out="$out · $b"; done; echo "${out# · }"; }
# In-box bind/cd target: a unique /work-<kebab(cwd)> per host folder (only [a-z0-9-], so it is always shell-safe).
wtarget(){ printf '/work-%s' "$(printf '%s' "${PWD#/}" | tr 'A-Z' 'a-z' | sed 's#[^a-z0-9]#-#g; s#-\{2,\}#-#g; s#-$##')"; }
# Built-in fallback profile: baked in so the tool works with no templates dir at all (git + gh + node22 + claude-code).
builtin_default_profile(){ cat <<'EOF'
# agentbox box profile: claude — Claude Code, kept to just this one folder. YOUR copy, tweak it freely.
# template-version: 3.12.0                   # bumps whenever this template changes — ab warns if your copy is behind
# Baked-in fallback, identical to the claude template — used when no shipped templates are present.
# Simple mode — just pick an AGENT and go. Want full control? Set INSTALL='…' and write the build steps yourself.
AGENT=claude                        # who runs the box:  claude · codex · copilot · none
PKGS="gh git curl"                  # extra apt packages baked in — 'gh' also sets up GitHub so you can push (with GH_TOKEN)
TOKENS="CLAUDE_CODE_OAUTH_TOKEN GH_TOKEN"  # which of your saved keys get passed in — nothing else of yours leaks into the box
RUN="claude"                        # what runs when you enter (empty = a plain shell);  `ab claude <cmd>` overrides it
MOUNT=cwd                           # cwd = share this folder (opens as /work-<name>) · none = share nothing (sealed)
EPHEMERAL=0                         # 0 = keep the box around (quick to re-enter) · 1 = fresh box each run, gone on exit
#DIST=debian                        # base distro for this box (overrides the global default) — e.g. debian, ubuntu, kali
#MITM=0                             # 1 = watch the box's web traffic through mitmweb (proxy 127.0.0.1:8082, viewer :8083)
EOF
}
# Read a profile/template's '# template-version:' stamp (empty if unstamped, e.g. a pre-3.8 copy).
tplver(){ sed -n 's/^# *template-version:[[:space:]]*\([^[:space:]]*\).*/\1/p' "$1" 2>/dev/null | head -1; }
# One-line summary of a template's key settings (what it runs · tokens it needs · notable flags) — used by the help screen.
tpldesc(){ ( . "$1" 2>/dev/null; local d
  if [ -n "$INSTALL" ]; then d="complex mode"; [ -n "$DESKTOP" ] && d="${DIST:-debian} $DESKTOP desktop, complex mode"
  elif [ -n "$DESKTOP" ]; then d="$DESKTOP desktop ($APP)"
  elif [ "${AGENT:-none}" = none ]; then d="plain shell"
  elif [ -z "$RUN" ]; then d="$AGENT installed, opens a shell"
  else d="runs $RUN"; fi
  [ "${MITM:-0}" = 1 ] && d="$d · MITM"
  [ "${RFB:-0}" = 1 ] && d="$d · RFB"
  [ -n "${GPU:-}" ] && d="$d · $GPU GPU"
  [ "${EPHEMERAL:-0}" = 1 ] && d="$d · throwaway"
  [ "${MOUNT:-cwd}" = none ] && d="$d · sealed"
  printf '%s' "$d" ) }
# Seed a profile file: a shipped template of that name if valid, else the built-in default (kept 0600).
aboxdefault(){ local path="$1" name="$2" src="$TPL/$2.conf"   # NB: $2, not $name — a var can't reference a sibling set in the SAME 'local' (it expands before the assignment), which silently made src=$TPL/.conf and every non-claude box fall back to claude
  if [ -f "$src" ] && [ -s "$src" ] && grep -q '^# agentbox box profile' "$src"; then ( umask 077; cp "$src" "$path" )
  else ( umask 077; builtin_default_profile > "$path" )   # no valid template → the built-in default (a CLAUDE box)
    msg "no '$name' template found — seeded $(short "$path") from the built-in default, which is a CLAUDE box. If you expected a shipped template ('$name'), run 'ab update' to (re)fetch it, then: ab remove $name && ab $name" "$Y"
  fi; }
# Every name ab already knows — your profiles + the shipped templates, deduped. Printed when an unknown name is typed,
# so a typo ('clade') is spotted against the real ones instead of silently becoming a new box.
aboxknown(){ local f b out=; for f in "$VC"/profile/*.conf "$TPL"/*.conf; do [ -e "$f" ] || continue
    b=$(basename "$f" .conf); case " $out " in *" $b "*) continue;; esac; out="$out $b"; done
  printf '%s\n' "${out# }" | sed 's/ / · /g'; }
# `ab <name>` with no profile of that name is BOTH how a box is created and what a typo looks like — and creating one
# downloads a few hundred MB. So ask first: Enter (or y) creates, n/q cancels before anything is written or fetched.
# Default-yes keeps the intended path to a single extra keystroke. Creates straight away, no question asked, when:
# AB_YES=1 (scripts/cron), there is no terminal to ask on, or the rootfs is already built and only the conf went missing.
aboxnewok(){ local prof="$1" t="${AGENTBOX_TTY:-/dev/tty}" src="$TPL/$1.conf" a from known
  [ "${AB_YES:-}" = 1 ] && return 0
  [ -n "$(pdroot "$(aboxalias "$prof")")" ] && return 0
  ( : < "$t" ) 2>/dev/null || return 0                            # no controlling terminal → old behaviour, just create
  if [ -f "$src" ]; then from="the '$prof' template"
  else from="the built-in default (a claude box)"
    known=$(aboxknown); [ -n "$known" ] && printf '%sknown names: %s%s\n' "$DM" "$known" "$Z" > "$t"
  fi
  printf "%sno box '%s' yet — create it from %s? [Y/n] %s" "$Y" "$prof" "$from" "$Z" > "$t"
  IFS= read -r a < "$t" || a=n
  case "$a" in [NnQq]*) msg "cancelled — nothing created" "$Y"; return 1;; esac; return 0; }
# Which processes belong to a box — the one question the host can't answer with ps/pgrep. proot execs every guest
# binary through $PREFIX/libexec/proot/loader and leaves argv untouched, so a box process shows on the host as a bare
# `dbus-daemon` whose /proc/<pid>/exe is the LOADER: neither exe nor argv says which box, or that it's in a box at all.
# What does say so is /proc/<pid>/maps — the guest binary and every library it loaded are mapped by their real HOST
# path under the rootfs. (Until 3.22.0 this matched exe against the rootfs, which therefore matched nothing: every
# daemonised desktop process survived `ab stop`. Seen in the wild as an orphaned at-spi dbus-daemon still spinning 96%
# of a core ten hours after its desktop was closed — see `ab ps`.)
boxpids(){ local rootfs="$1" f; [ -n "$rootfs" ] && [ -d "$rootfs" ] || return 0
  for f in $(grep -lsm1 -F -- "$rootfs/" /proc/[0-9]*/maps 2>/dev/null); do f=${f#/proc/}; printf '%s\n' "${f%/maps}"; done; }
psbox(){ local a; a=$(grep -som1 -E -- "$PDLIB/(containers/[^/]+/rootfs|installed-rootfs/[^/]+)/" "/proc/$1/maps") || return 1
  a=${a#"$PDLIB"/}; a=${a#containers/}; a=${a#installed-rootfs/}; printf '%s' "${a%%/*}"; }
boxkillprocs(){ local rootfs="$1" p; for p in $(boxpids "$rootfs"); do [ "$p" = "$$" ] || kill -9 "$p" 2>/dev/null; done; return 0; }
aboxdrop(){ local a="$1" r; [ -n "$a" ] || return 0     # delete a built box (by alias); dir-remove as a fallback
  r=$(pdroot "$a"); [ -n "$r" ] && boxkillprocs "$r"     # kill procs running out of this rootfs, else remove/install says 'busy'
  pkill -9 -f "$a" 2>/dev/null                          # and the proot wrapper itself (its argv holds the alias)
  proot-distro remove "$a" 2>/dev/null
  r=$(pdroot "$a"); [ -z "$r" ] || rm -rf "${r%/rootfs}"; }
# Simple mode: with no INSTALL in the conf, generate the build steps from AGENT (+ extra PKGS). Docker mode (the conf
# sets INSTALL='…') bypasses this and runs those raw steps verbatim. Returns 3 on an unknown AGENT.
# 'gh' in PKGS is special-cased: it adds GitHub's apt repo + a git credential helper so the box can push with GH_TOKEN.
agent_recipe(){ local agent="${1:-none}" pkgs="${2:-}" gh=
  case " $pkgs " in *" gh "*) gh=1; pkgs=$(printf '%s' "$pkgs" | tr ' ' '\n' | grep -vx gh | paste -sd' ' -);; esac
  [ -n "$pkgs" ] && printf 'apt-get install -y %s\n' "$pkgs"
  case "$agent" in
    claude)  printf 'apt-get install -y git\ninstall-node 22\nnpm install -g @anthropic-ai/claude-code\n';;
    codex)   printf 'apt-get install -y git\ninstall-node 22\nnpm install -g @openai/codex\n';;
    copilot) printf 'apt-get install -y git\ninstall-node 22\nnpm install -g @github/copilot\n';;
    none|'') :;;
    *) return 3;;
  esac
  [ -n "$gh" ] && cat <<'GH'
apt-get install -y git curl ca-certificates
gharch=$(dpkg --print-architecture)
case "$gharch" in
  amd64|arm64)
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg
    chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$gharch signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
    apt-get update && apt-get install -y gh ;;
  *)  # no gh apt package for this arch (armhf/i386…) — install the release binary from GitHub
    case "$gharch" in armhf) ga=armv6;; i386) ga=386;; *) ga=$gharch;; esac
    gv=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1)
    curl -fsSL "https://github.com/cli/cli/releases/download/v${gv}/gh_${gv}_linux_${ga}.tar.gz" | tar -xz -C /tmp
    install -m755 "/tmp/gh_${gv}_linux_${ga}/bin/gh" /usr/local/bin/gh
    rm -rf "/tmp/gh_${gv}_linux_${ga}" ;;
esac
git config --system credential.https://github.com.helper '!gh auth git-credential'
GH
  return 0; }
# DESKTOP= names WHICH session, not just "on": xfce (minimal — session + wm only, the long-standing default) or kde
# (a full Plasma desktop: fancy, and heavy). Anything else maps to xfce, so profiles from when the value was a label
# nobody read keep building exactly as before. desession() is the in-box binary both the installer and the launcher
# test for — one definition, so "did the stack install" and "what do we exec" can never disagree.
dename(){ case "${1:-}" in kde|plasma|KDE|Plasma) echo kde;; *) echo xfce;; esac; }
desession(){ [ "$(dename "${1:-}")" = kde ] && echo /usr/bin/startplasma-x11 || echo /usr/bin/startxfce4; }
# Build the box for profile <name> from its conf: base (apt update + curl + ca-certificates + install-node helper),
# then INSTALL (docker mode) or the AGENT/PKGS recipe (simple mode), then mitmproxy (MITM=1), then the desktop (DESKTOP).
aboxbuild(){ local prof="$1" force="${2:-}" cf alias rootfs de=xfce DIST="$DIST" \
    INSTALL= TOKENS= RUN= MOUNT=cwd EPHEMERAL=0 DESKTOP= APP=code MITM=0 LAN=0 RFB=0 GPU= AGENT=none PKGS=
  cf=$(aboxconf "$prof"); alias=$(aboxalias "$prof"); [ -f "$cf" ] && . "$cf"; DIST="${DIST:-debian}"
  de=$(dename "$DESKTOP")                                       # which session the desktop stack installs (xfce | kde)
  [ -n "$INSTALL" ] || INSTALL=$(agent_recipe "$AGENT" "$PKGS") \
    || { msg "profile '$prof': unknown AGENT '$AGENT' (use claude|codex|copilot|none)" "$R"; return 1; }
  { [ "$force" = force ] && [ -n "$(pdroot "$alias")" ]; } && { aboxguard "$prof"; aboxdrop "$alias"; }
  if [ -z "$(pdroot "$alias")" ]; then
    msg "building box '$prof' — $DIST (first build downloads a few hundred MB)…" "$G"
    proot-distro install "$DIST" --override-alias "$alias" \
      || { msg "install failed — update proot-distro: pkg upgrade proot-distro" "$R"; return 1; }
  fi
  rootfs=$(pdroot "$alias"); [ -n "$rootfs" ] || { msg "box '$prof' rootfs not found" "$R"; return 1; }
  [ -n "$DESKTOP" ] && { msg "  DESKTOP=$DESKTOP → installing the desktop stack ($([ "$de" = kde ] && echo 'full KDE Plasma — ~2 GB, the slow one' || echo 'minimal xfce') + KasmVNC + chromium$([ "$APP" = code ] && echo ' + code-server'); heavy)…" "$Y"
    guiinstallscript "$rootfs/root/.gui-install.sh"; }
  { printf '#!/bin/bash\nset -e\nexport DEBIAN_FRONTEND=noninteractive\ndpkg --configure -a 2>/dev/null || true\napt-get update\napt-get install -y curl ca-certificates\n'
    printf 'install-node(){ command -v node >/dev/null 2>&1 && return 0; curl -fsSL "https://deb.nodesource.com/setup_${1:-22}.x" | bash - ; apt-get install -y nodejs; }\n'
    [ -n "$INSTALL" ] && printf '%s\n' "$INSTALL"
    [ "$MITM" = 1 ] && printf 'apt-get install -y mitmproxy%s || { apt-get install -y python3-pip python3-venv libnss3-tools && pip3 install --break-system-packages mitmproxy; }\n' "$([ -n "$DESKTOP" ] && printf ' libnss3-tools')"
    [ -n "$DESKTOP" ] && printf 'bash /root/.gui-install.sh %s %s %s\n' "${AGENTBOX_KASMVNC_VER:-1.4.0}" "$APP" "$de"
  } > "$rootfs/root/.abbuild.sh"
  mkdir -p "$rootfs/root/.claude"
  [ -f "$rootfs/root/.claude/.claude.json" ] || printf '{"hasCompletedOnboarding": true}\n' > "$rootfs/root/.claude/.claude.json"
  if proot-distro login "$alias" -- bash /root/.abbuild.sh; then rm -f "$rootfs/root/.abbuild.sh" "$rootfs/root/.gui-install.sh"; msg "box '$prof' ready" "$G"
  else rm -f "$rootfs/root/.abbuild.sh" "$rootfs/root/.gui-install.sh"; msg "build failed for '$prof' (see output above)" "$R"; return 1; fi; }
# `ab upgrade <name>` — refresh a BUILT box's packages IN PLACE: apt update/upgrade, then re-run its (idempotent) agent/PKGS
# recipe so the CLI agent + apt packages move to latest, WITHOUT deleting the rootfs (no re-download). Sits between
# `ab update` (updates agentbox itself, never box contents) and `ab rebuild` (wipes + reinstalls). Docker-mode boxes
# (INSTALL set in the conf) re-run those steps verbatim; the desktop stack is untouched — rebuild for that.
boxupgrade(){ local prof="${1:-}" alias rootfs cf INSTALL= TOKENS= RUN= MOUNT=cwd EPHEMERAL=0 DESKTOP= APP=code MITM=0 LAN=0 RFB=0 GPU= AGENT=none PKGS= DIST=
  [ -n "$prof" ] || { msg "which box? ab upgrade <name>" "$Y"; return 1; }
  alias=$(aboxalias "$prof"); rootfs=$(pdroot "$alias")
  [ -n "$rootfs" ] || { msg "box '$prof' isn't built yet — nothing to upgrade; run it first: ab run $prof" "$Y"; return 1; }
  cf=$(aboxconf "$prof"); [ -f "$cf" ] && . "$cf"
  [ -n "$INSTALL" ] || INSTALL=$(agent_recipe "$AGENT" "$PKGS") \
    || { msg "profile '$prof': unknown AGENT '$AGENT' (use claude|codex|copilot|none)" "$R"; return 1; }
  aboxguard "$prof"                                             # if THIS box's desktop is live, stop it first (apt-upgrading a running desktop is asking for trouble)
  msg "upgrading box '$prof' in place — apt update/upgrade + agent/PKGS refresh (no rebuild, no re-download)…" "$G"
  { printf '#!/bin/bash\nset -e\nexport DEBIAN_FRONTEND=noninteractive\ndpkg --configure -a 2>/dev/null || true\napt-get update\napt-get -y upgrade\n'
    printf 'install-node(){ command -v node >/dev/null 2>&1 && return 0; curl -fsSL "https://deb.nodesource.com/setup_${1:-22}.x" | bash - ; apt-get install -y nodejs; }\n'
    [ -n "$INSTALL" ] && printf '%s\n' "$INSTALL"
    printf 'apt-get -y autoremove || true; apt-get clean || true\n'
  } > "$rootfs/root/.abupgrade.sh"
  if proot-distro login "$alias" -- bash /root/.abupgrade.sh; then rm -f "$rootfs/root/.abupgrade.sh"; msg "box '$prof' upgraded (packages current; rebuild only for AGENT/DESKTOP changes: ab rebuild $prof)" "$G"
  else rm -f "$rootfs/root/.abupgrade.sh"; msg "upgrade failed for '$prof' (see output above)" "$R"; return 1; fi; }
# Stop the running box desktop (session ab-boxgui); a throwaway (EPHEMERAL=1) desktop box is deleted on stop so
# its next launch is genuinely fresh (this is where EPHEMERAL is honoured for desktop boxes).
aboxguistop(){ local prof rootfs; prof=$(cat "$STATE/boxgui.prof" 2>/dev/null)
  [ -n "$prof" ] && rootfs=$(pdroot "$(aboxalias "$prof")")
  tmux kill-session -t "=ab-boxgui" 2>/dev/null; boxkillprocs "$rootfs"   # Xvnc/chromium/mitmweb daemons don't die with the session
  rm -f "$STATE/boxgui.prof"
  if [ -n "$prof" ]; then local cf INSTALL TOKENS RUN MOUNT EPHEMERAL=0 DESKTOP APP MITM LAN RFB GPU AGENT PKGS DIST
    cf=$(aboxconf "$prof"); [ -f "$cf" ] && . "$cf"
    [ "$EPHEMERAL" = 1 ] && aboxdrop "$(aboxalias "$prof")" && msg "throwaway box '$prof' deleted — next launch is fresh" "$Y"; fi
  anysession || { [ "$(wakestat)" = on ] && wakeoff; }; return 0; }
# `ab stop` — close the running box desktop. Keeps the box (so reopening is instant, no rebuild) unless it's EPHEMERAL=1,
# which aboxguistop then deletes. To force a fresh rebuild instead, use `ab remove <name>`.
boxstop(){ tmux has-session -t "=ab-boxgui" 2>/dev/null || { msg "no box desktop is running" "$Y"; return 0; }
  aboxguistop; msg "box desktop stopped" "$G"; }

# ── `ab ps` — everything agentbox has spawned, what it costs, and how to stop it ────
# The question this answers is "why is the phone hot / where did the battery go?", so every row carries TWO numbers:
# LIVE is a real sample (share of ONE core over $sample seconds — what is draining right now) and CPU is the lifetime
# total (what it has already cost). A held wakelock makes both matter with the screen off and the phone in a pocket,
# so it leads the report.
# STRAY is the finding this command exists for: an orphaned box process (ppid 1) in a box that nothing owns any more.
# A desktop's own Xvnc/x11vnc/chromium/dbus ARE daemonised and sit at ppid 1 by design — legitimately, while ab-boxgui
# lives. Once it doesn't, nothing on this phone will ever stop them again: they don't show in `ab session`, `ab stop`
# says there's no desktop, and they hold a core until you reboot. `ab ps kill` is the one thing that clears them.
# The judgement is per BOX, not per process (see below), so a box you are actively using is never accused.
psdur(){ local s="${1:-0}"; case "$s" in ''|*[!0-9]*) printf '?'; return;; esac
  [ "$s" -ge 3600 ] && { printf '%dh%02dm' $((s/3600)) $((s%3600/60)); return; }
  [ "$s" -ge 60 ] && { printf '%dm' $((s/60)); return; }; printf '%ds' "$s"; }
# The tmux session that owns a pid, by walking the parent chain until it hits a pane (fork-free — one read a hop).
# Nothing found = nobody will ever stop this process: either it was daemonised on purpose, or it was orphaned.
# /proc/<pid>/stat is parsed comm-safely everywhere here: the comm field is parenthesised and may hold spaces, so cut
# through the LAST ')' first — after that the fields shift by 2 (state [0], ppid [1], utime [11], stime [12]).
psown(){ local q="$1" panes="$2" i=0 s l; local -a sf
  while [ "${q:-0}" -gt 1 ] && [ "$i" -lt 32 ]; do
    case " $panes " in *" $q:"*) s=${panes##*" $q:"}; printf '%s' "${s%% *}"; return 0;; esac
    read -r l 2>/dev/null < "/proc/$q/stat" || return 1
    l=${l#*") "}; sf=($l); q=${sf[1]}; i=$((i+1))
  done; return 1; }
abps(){ local verb="${1:-}"; [ $# -gt 0 ] && shift
  local t="${AGENTBOX_TTY:-/dev/tty}" sample="${AB_PS_SAMPLE:-2}" hz cores p pid box cmd own age cpu live note col lbl n now
  local panes= nsess=0 boxmap= busy= guibox= guiprof= guiup=0 nbox=0 nstray=0 nhid=0 livetot=0 cputot=0 straycpu=0 lock virgl= a f w l w0 w1 us
  local -a PID=() CMD=() BOX=() PP=() T0=() T1=() CLS=() rows=() KILL=() KN=() sf
  local WIDE=1 cols; cols=$(tput cols 2>/dev/null || echo "${COLUMNS:-80}"); [ "$cols" -ge 1 ] 2>/dev/null || cols=80
  [ "$cols" -lt 72 ] && WIDE=0                                         # same threshold as the help screen; row() reads it too
  hz=$(getconf CLK_TCK 2>/dev/null); case "$hz" in ''|*[!0-9]*) hz=100;; esac
  cores=$(nproc 2>/dev/null); case "$cores" in ''|*[!0-9]*) cores=1;; esac
  case "$sample" in ''|0|*[!0-9]*) sample=2;; esac
  nsess=$(tmux ls -F '#S' 2>/dev/null | wc -l | tr -d ' ')
  while IFS=$'\t' read -r p a; do [ -n "$p" ] && panes="$panes $p:$a"; done \
    < <(tmux list-panes -a -F "#{pane_pid}"$'\t'"#{session_name}" 2>/dev/null)
  guiprof=$(cat "$STATE/boxgui.prof" 2>/dev/null)
  tmux has-session -t "=ab-boxgui" 2>/dev/null && [ -n "$guiprof" ] && { guiup=1; guibox=$(aboxalias "$guiprof"); }
  # One grep over every readable maps answers "is this pid in a box, and which one" for the whole phone at once.
  for f in $(grep -lsm1 -F -- "$PDLIB/" /proc/[0-9]*/maps 2>/dev/null); do
    pid=${f#/proc/}; pid=${pid%/maps}; a=$(psbox "$pid") || continue; boxmap="$boxmap $pid:$a"; done
  for p in /proc/[0-9]*; do pid=${p#/proc/}; [ "$pid" = "$$" ] && continue
    read -r l 2>/dev/null < "$p/stat" || continue; l=${l#*") "}; sf=($l)
    cmd=; while IFS= read -r -d '' w || [ -n "$w" ]; do cmd="$cmd${cmd:+ }$w"; done 2>/dev/null < "$p/cmdline"
    [ -n "$cmd" ] || { read -r cmd 2>/dev/null < "$p/comm" || cmd='?'; cmd="[$cmd]"; }
    box=; case " $boxmap " in *" $pid:"*) box=${boxmap##*" $pid:"}; box=${box%% *};; esac
    PID+=("$pid"); CMD+=("$cmd"); BOX+=("$box"); PP+=("${sf[1]}")
  done
  # The two tick passes are tight, fork-free and adjacent to their timestamps, and the window is MEASURED rather than
  # assumed. Both matter: gathering argv above, or formatting rows below, inside the window would hand later processes
  # a longer one and inflate their share (a single-threaded spinner read 121% before this was split out).
  [ -t 1 ] && printf '%s %ssampling %ss…%s\r' "${BD}agentbox activity${Z}" "$DM" "$sample" "$Z"
  w0=${EPOCHREALTIME:-}
  for n in "${!PID[@]}"; do
    if read -r l 2>/dev/null < "/proc/${PID[n]}/stat"; then l=${l#*") "}; sf=($l); T0+=("$(( ${sf[11]} + ${sf[12]} ))")
    else T0+=(0); fi; done
  sleep "$sample"
  for n in "${!PID[@]}"; do
    if read -r l 2>/dev/null < "/proc/${PID[n]}/stat"; then l=${l#*") "}; sf=($l); T1+=("$(( ${sf[11]} + ${sf[12]} ))")
    else T1+=("${T0[n]}"); fi; done                                    # exited during the sample → no delta, still listed
  w1=${EPOCHREALTIME:-}
  w0=${w0/[.,]/}; w1=${w1/[.,]/}; us=0                                 # EPOCHREALTIME → µs; absent (bash 4) → the nominal window
  case "$w0$w1" in ''|*[!0-9]*) :;; *) us=$((w1-w0));; esac; [ "$us" -gt 0 ] || us=$((sample*1000000))
  # Ownership, then strays. A stray is judged per BOX, not per process: an orphan (ppid 1) is normal while something
  # else in the same box is alive — a desktop daemonises Xvnc/x11vnc/chromium on purpose — and only becomes a stray
  # when nothing owns that box any more, which is the point at which nothing left on the phone can ever stop it.
  for n in "${!PID[@]}"; do box="${BOX[n]}"
    if [ -z "$box" ]; then CLS+=(host); continue; fi
    nbox=$((nbox+1)); own=$(psown "${PID[n]}" "$panes") || own=
    if [ -n "$own" ]; then CLS+=("session ${own#ab-}")
    elif [ "$guiup" = 1 ] && [ "$box" = "$guibox" ]; then CLS+=(desktop)
    elif [ "${PP[n]}" = 1 ]; then CLS+=(orphan); continue                # busy-marked only by a process something still owns
    else CLS+=(fg); fi
    busy="$busy $box "
  done
  now=$(date +%s)
  for n in "${!PID[@]}"; do pid="${PID[n]}"; box="${BOX[n]}"; cmd="${CMD[n]}"
    live=$(( (${T1[n]} - ${T0[n]}) * 100000000 / (hz * us) )); [ "$live" -lt 0 ] && live=0
    cpu=$(( ${T1[n]} / hz )); lbl=termux; note=; col=; own=
    # What this process IS: argv[0]'s basename, plus the script name when that alone says nothing (bash → bash agentbox).
    a=${cmd%% *}; a=${a##*/}
    case "$a" in bash|sh|dash|env|python*|node|perl|ruby) w=${cmd#* }; w=${w%% *}; w=${w##*/}
      [ -n "$w" ] && [ "$w" != "$cmd" ] && a="$a $w";; esac
    if [ -n "$box" ]; then                                             # a process INSIDE a box (invisible to ps/pgrep)
      lbl="${box#agentbox-}"
      case "${CLS[n]}" in
        session*) note="${CLS[n]}";;
        desktop)  note="box desktop — ab stop"; col="$G";;
        fg)       note="no session — started in the foreground";;
        orphan) case " $busy " in *" $box "*) note="orphan of a box still in use — nothing will stop it either"; col="$Y";;
            *) note="STRAY — its box is gone; only ab ps kill stops it"; col="$R"; nstray=$((nstray+1)); straycpu=$((straycpu+live))
               KILL+=("$pid"); KN+=("$lbl $a");; esac;;
      esac
      # An active box forks constantly (the agent's own greps, gits, shells). Those are noise; an orphan never is.
      case "${CLS[n]}" in orphan) :;; *) { [ "$live" -ge 1 ] || [ "$cpu" -ge 60 ]; } || { nhid=$((nhid+1)); continue; };; esac
    else
      case "$cmd" in *agentbox*|*proot*|*tmux*) own=$(psown "$pid" "$panes") || own=;; esac
      case "$cmd" in                                                   # host side: the pieces agentbox runs in Termux
        *"/bin/proot "*|*proot-distro*) f=; for w in $cmd; do case "$w" in *agentbox-*) f=${w##*/};; esac; done
          lbl=host; case "$f" in agentbox-*) lbl="${f#agentbox-}";; esac
          note="proot — this box's syscall translator${own:+ (session ${own#ab-})}";;
        *virgl_test_server_android*) lbl=host; virgl="$pid"
          if [ "$guiup" = 1 ]; then note="GPU=virgl server — rendering for the '$guiprof' desktop"
          else note="GPU=virgl server — no desktop is running, still resident"; col="$Y"; fi;;
        *agentbox*sync\ watch-run*) lbl=host; note="sync watch loop — wakes every ${cmd##* }s${own:+ (session ${own#ab-})}";;
        tmux|tmux:*|*/tmux|tmux\ *|*/tmux\ *) lbl=host
          case "$cmd" in *" -s "*) f=${cmd#*" -s "}; f=${f%% *}; note="tmux — the '${f#ab-}' session";;
                         *) note="tmux server — $nsess session(s); every box hangs off it";; esac;;
        *agentbox*|*"/bin/ab "*) lbl=host; note="agentbox${own:+ (session ${own#ab-})}"   # a wrapper shell earns a row only if it costs
          { [ "$live" -ge 1 ] || [ "$cpu" -ge 60 ]; } || { nhid=$((nhid+1)); continue; };;
        com.termux|com.termux:*) lbl=termux; note="the Termux app itself — everything above runs inside it";;
        *) [ "$live" -ge 5 ] || [ "$cpu" -ge 600 ] || continue         # anything else earns a row only by costing something
           note="not agentbox's — listed because it's busy"; col="$DM";;
      esac; fi
    age=$(stat -c %Y "/proc/$pid" 2>/dev/null) && age=$(( now - age )) || age=
    livetot=$((livetot+live)); cputot=$((cputot+cpu))
    if [ "$WIDE" = 1 ]; then                                           # phone-portrait terminals drop the age column
      rows+=("$(printf '%08d\t%012d\t  %s%4s%%%s  %s%-9s%s %-20s %6s %6s  %s%s%s' "$live" "$cpu" \
        "${col:-$BD}" "$live" "$Z" "$DM" "$(printf '%.9s' "$lbl")" "$Z" "$(printf '%.20s' "$a")" \
        "$(psdur "$cpu")" "$(psdur "$age")" "${col:-$DM}" "$note" "$Z")")
    else
      rows+=("$(printf '%08d\t%012d\t %s%3s%%%s %s%-7s%s %-12s %5s  %s%s%s' "$live" "$cpu" \
        "${col:-$BD}" "$live" "$Z" "$DM" "$(printf '%.7s' "$lbl")" "$Z" "$(printf '%.12s' "$a")" \
        "$(psdur "$cpu")" "${col:-$DM}" "$note" "$Z")")
    fi
  done
  lock=$(wakestat)
  printf '%s %s\n' "${BD}agentbox activity${Z}" "${DM}$nbox box process(es) · $nsess tmux session(s) · $cores cores · ${sample}s sample${Z}"
  hd "▍Power"
  [ "$lock" = on ] && { anysession \
      && st "wakelock" "ON — the phone cannot sleep while an ab- session is open (frees with the last one)" "$Y" \
      || st "wakelock" "ON but NO session holds it — leaked; the phone has not slept since. Release: ab ps kill" "$R"; } \
    || st "wakelock" "off — normal sleep" "$G"
  st "right now" "$livetot% of one core ($cores available) across the rows below" "$([ "$livetot" -ge 80 ] && echo "$R" || echo "$G")"
  st "spent" "$(psdur "$cputot") of CPU since these processes started" "$DM"
  [ "$nstray" -gt 0 ] && st "strays" "$nstray process(es) outliving their box — $straycpu% of a core, and nothing but 'ab ps kill' will stop them" "$R" \
    || st "strays" "none — everything running has a session or a desktop that can stop it" "$G"
  hd "▍Processes" "live%  ·  box/host  ·  command  ·  cpu total$([ "$WIDE" = 1 ] && printf '  ·  age')$([ "$nhid" -gt 0 ] && printf ' (+%s idle process(es) not shown)' "$nhid")"
  if [ "${#rows[@]}" -eq 0 ]; then st "nothing" "no box, no session, no helper — agentbox is idle" "$G"
  else printf '%s\n' "${rows[@]}" | sort -t$'\t' -k1,1nr -k2,2nr | cut -f3-; fi
  hd "▍Stop"
  a=; [ "$nstray" -gt 0 ] && a="kill $nstray stray process(es) (~$straycpu% of a core)"
  [ -n "$virgl" ] && [ "$guiup" != 1 ] && a="${a:+$a + }stop the idle GPU=virgl server"
  { [ "$lock" = on ] && ! anysession; } && a="${a:+$a + }release the leaked wakelock"
  [ -n "$a" ] && row "ab ps kill" "" "$a — boxes, sessions and desktops untouched"
  [ "$guiup" = 1 ] && row "ab stop" "" "close the '$guiprof' box desktop (keeps the box; reopen with ab $guiprof)"
  [ "$nsess" -gt 0 ] && row "ab session kill" "[name]" "end a session — its box exits with it, and the wakelock frees with the last one"
  { [ -n "$a" ] || [ "$guiup" = 1 ] || [ "$nsess" -gt 0 ]; } || row "nothing to stop" "" "no strays, no desktop, no sessions — agentbox is costing nothing"
  [ "$verb" = kill ] || return 0
  # ── kill: strays only, never a process something living still owns ──
  [ -n "$virgl" ] && [ "$guiup" != 1 ] && { KILL+=("$virgl"); KN+=("host virgl_test_server_android"); }
  if [ "$#" -gt 0 ]; then local -a K2=() N2=(); for w in "$@"; do n=0                # explicit pids: only ones ab knows
      for p in "${!KILL[@]}"; do [ "${KILL[p]}" = "$w" ] && { K2+=("$w"); N2+=("${KN[p]}"); n=1; }; done
      [ "$n" = 1 ] || msg "pid $w is not a stray ab can account for — not killing it" "$Y"; done
    KILL=("${K2[@]}"); KN=("${N2[@]}"); fi
  if [ "${#KILL[@]}" -eq 0 ]; then
    { [ "$lock" = on ] && ! anysession; } && { wakeoff; return 0; }
    msg "nothing to clear" "$G"; return 0; fi
  printf '\n'; for n in "${!KILL[@]}"; do msg "  kill -9 ${KILL[n]}  ${KN[n]}" "$Y"; done
  if [ "${AB_YES:-}" != 1 ] && ( : < "$t" ) 2>/dev/null; then         # ask on the terminal, not stdin (same as box creation)
    printf '%skill %s process(es)? [Y/n] %s' "$Y" "${#KILL[@]}" "$Z" > "$t"; IFS= read -r a < "$t" || a=
    case "$a" in [NnQq]*) msg "cancelled — nothing killed" "$Y"; return 1;; esac; fi
  n=0; for p in "${KILL[@]}"; do kill -9 "$p" 2>/dev/null && n=$((n+1)); done
  msg "killed $n process(es)" "$G"
  anysession || { [ "$(wakestat)" = on ] && wakeoff; }; return 0; }
# `ab pw <name> [password]` — set (or show) a desktop box's login password. Stored 0600 at $VC/gui-<name>.pw; aboxgui uses
# it instead of a fresh random one. Applies on the next launch (ab stop; ab <name>). No password arg → show the current.
abpw(){ local prof="${1:-}" pw="${2:-}" f
  [ -n "$prof" ] || { msg "usage: ab pw <name> [password]   (no password = show the current one)" "$Y"; return 1; }
  f="$VC/gui-$prof.pw"
  if [ -n "$pw" ]; then mkdir -p "$VC"; ( umask 077; printf '%s' "$pw" > "$f" )
    msg "password for '$prof' set (0600) — applies on the next launch: ab stop; ab $prof" "$G"
  elif [ -f "$f" ]; then msg "'$prof' desktop password: $(cat "$f")   (change: ab pw $prof <new>)" "$G"
  else msg "'$prof' uses a fresh random password each launch. Set a fixed one: ab pw $prof <password>" "$Y"; fi; }
# If <prof>'s desktop is the one currently running, stop it before we delete/rebuild its rootfs (proot is userspace —
# rm -rf under a live session would corrupt it and orphan the session + wakelock).
aboxguard(){ [ -f "$STATE/boxgui.prof" ] && [ "$(cat "$STATE/boxgui.prof" 2>/dev/null)" = "$1" ] \
    && tmux has-session -t "=ab-boxgui" 2>/dev/null \
    && { msg "stopping box '$1's running desktop first…" "$Y"; aboxguistop; }; return 0; }
# ── GPU=virgl (desktop boxes) ──────────────────────────────────────
# WHY a proxy and not a driver in the box: Debian/Ubuntu build Mesa's Adreno Vulkan driver (turnip) for the MSM DRM
# kernel interface, but Android exposes the GPU as /dev/kgsl-3d0 and hides /dev/dri, so an in-box turnip enumerates
# nothing. Instead a virgl *vtest* server runs on the TERMUX side, where Android's own GL driver is available (works on
# GPUs turnip can't drive yet, e.g. Adreno 830), and the box reaches it over ONE unix socket with GALLIUM_DRIVER=virpipe.
# Rendering lands on the GPU; frames still present through X shm, so KasmVNC is unchanged.
# NOTE this is a widening of the box boundary: vtest is not a hardened protocol. Opt-in per profile, hence GPU=.
# Echoes the socket path on success (warnings go to stderr so they never pollute the captured path).
virglsock(){ local c i s= log="${TMPDIR:-$PREFIX/tmp}/virgl-server.log"
  has virgl_test_server_android || { msg "  GPU=virgl → installing the Termux GPU server (x11-repo + virglrenderer-android)…" "$Y" >&2
    pkg install -y x11-repo >/dev/null 2>&1; pkg install -y virglrenderer-android >/dev/null 2>&1; }
  has virgl_test_server_android \
    || { msg "  GPU=virgl: virglrenderer-android didn't install — desktop continues on CPU (llvmpipe)" "$Y" >&2; return 1; }
  pgrep -f virgl_test_server_android >/dev/null 2>&1 || nohup virgl_test_server_android >"$log" 2>&1 &
  # Termux puts the socket in $TMPDIR; mesa's built-in default is /tmp/.virgl_test — probe, never assume.
  for i in $(seq 1 10); do
    for c in "${TMPDIR:-$PREFIX/tmp}/.virgl_test" "$PREFIX/tmp/.virgl_test" /tmp/.virgl_test; do
      [ -S "$c" ] && { s="$c"; break; }; done
    [ -n "$s" ] && break; sleep 1; done
  [ -n "$s" ] || { msg "  GPU=virgl: no vtest socket appeared (server log: $log) — desktop continues on CPU" "$Y" >&2; return 1; }
  printf '%s' "$s"; }
# The box side needs mesa's virgl/vtest client, which stock libgl1-mesa-dri already carries (no custom Mesa build).
# Done at LAUNCH, not build: one code path that also fixes desktop boxes built before GPU= existed. Idempotent — the
# host-side glob check costs nothing once installed.
boxgl(){ local rootfs="$1" alias="$2" f
  for f in "$rootfs"/usr/lib/*/libgallium*.so*; do [ -e "$f" ] && return 0; done
  msg "  GPU=virgl → adding mesa's virgl client to the box (one-off apt: libgl1-mesa-dri mesa-utils)…" "$Y"
  proot-distro login "$alias" --isolated -- bash -c 'export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq && apt-get install -y --no-install-recommends libgl1-mesa-dri mesa-utils' >/dev/null 2>&1 \
    || { msg "  GPU=virgl: mesa install failed (network?) — desktop continues on CPU" "$Y"; return 1; }
  return 0; }
# ── RFB=1 (desktop boxes): a native-VNC door beside the browser one ─
# WHY: KasmVNC deliberately broke from the RFB spec and serves only its own browser client, and that client maps touch
# ABSOLUTELY — your finger IS the pointer, so a tap lands where you touched and there is no trackpad mode (upstream
# noVNC has an open request for one, #1764). Native Android viewers do have it — AVNC's 'Gesture style: Touchpad',
# bVNC's 'Simulated Touchpad' — but they speak plain RFB, which KasmVNC will not answer. RFB=1 runs x11vnc alongside,
# attached to the SAME X display :1, so one desktop has two doors: the browser on $GUI_BOXWEB, a trackpad-capable app
# on $GUI_BOXRFB. Same password, same session, same pixels — pick whichever input model suits the moment.
# NOTE classic VNC auth is a single shared password (no user) and its DES scheme reads only the first 8 characters —
# hence localhost-only unless LAN=1, exactly like the web client.
# Installed at LAUNCH, not build, so desktop boxes made before this release pick it up without a rebuild. Idempotent.
boxrfb(){ local rootfs="$1" alias="$2"
  [ -x "$rootfs/usr/bin/x11vnc" ] && return 0
  msg "  RFB=1 → adding x11vnc to the box (one-off apt)…" "$Y"
  proot-distro login "$alias" --isolated -- bash -c 'export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq && apt-get install -y --no-install-recommends x11vnc' >/dev/null 2>&1
  [ -x "$rootfs/usr/bin/x11vnc" ] && return 0
  msg "  RFB=1: x11vnc install failed (network?) — the web desktop still opens" "$Y"; return 1; }
# Scoped desktop for a DESKTOP=xfce box: KasmVNC + (code-server for APP=code, or chromium for APP=browser) inside the
# box. Own ports (6902/8081, localhost); one box desktop at a time (session ab-boxgui). Fresh random password each
# start, printed. MOUNT=none binds nothing (SEALED); otherwise the cwd opens as /work-<cwd>. MITM=1 routes chromium
# through mitmweb (CA trusted into the box's nssdb, proxy flag added). GPU=virgl renders GL on the phone's GPU through
# the Termux-side vtest server (see virglsock), degrading to CPU if anything about that is unavailable. RFB=1 mirrors
# the same display onto a plain-VNC port for native viewers (see boxrfb), degrading to web-only if x11vnc won't run.
aboxgui(){ local prof="$1" alias="$2" rootfs="$3" app="${4:-code}" mnt="${5:-cwd}" mitm="${6:-0}" lan="${7:-0}" gpu="${8:-}" rfb="${9:-0}" de \
    pw tgt geo iface=127.0.0.1 lip= sock= gbind= gpuenv= rfbbind=-localhost i= sess=
  de=$(dename "${10:-xfce}"); sess=$(desession "$de")          # which session this box was built with (xfce | kde)
  [ "$lan" = 1 ] && iface=0.0.0.0                              # LAN=1 → bind KasmVNC/code-server to all interfaces (mitmweb stays local)
  needtmux || return 1
  # The session binary is the test, so switching DESKTOP= in the profile is caught here rather than as a black screen.
  { [ -x "$rootfs$sess" ] && [ -d "$rootfs/usr/share/kasmvnc" ]; } \
    || { msg "box '$prof' has no $de desktop stack ($sess missing — a different DESKTOP=, or never built) — rebuild it: ab remove $prof && ab $prof" "$Y"; return 1; }
  tmux has-session -t "=ab-boxgui" 2>/dev/null \
    && { msg "a box desktop is already running (one at a time) — close it first: ab stop" "$Y"; return 1; }
  # GPU=virgl: start/locate the Termux-side vtest server and make sure the box has mesa's virgl client. EVERY failure
  # degrades to CPU rendering with a warning — a GPU problem must never cost you the desktop.
  if [ "$gpu" = virgl ]; then sock=$(virglsock) || sock=; [ -n "$sock" ] && { boxgl "$rootfs" "$alias" || sock=; }; fi
  # RFB=1: make sure x11vnc is in the box, and clear last run's verdict markers so the summary reports THIS launch.
  # A failed install is NOT special-cased: the in-box script then finds no x11vnc, writes .rfb.fail, and the summary
  # reports web-only from that one source of truth rather than from two half-agreeing flags.
  [ "$rfb" = 1 ] && { boxrfb "$rootfs" "$alias"; rm -f "$rootfs/root/.rfb.ok" "$rootfs/root/.rfb.fail"; }
  [ "$lan" = 1 ] && rfbbind=                                   # LAN=1 → x11vnc listens on every interface too (default)
  pw=$(cat "$VC/gui-$prof.pw" 2>/dev/null); [ -n "$pw" ] || pw=$(gui_randpw)   # a fixed password (ab pw <name>) wins, else random
  mkdir -p "$rootfs/root/.vnc" "$rootfs/root/.config/code-server"
  # blacklist_threshold=100: every client arrives as 127.0.0.1 and each page-load counts as a failed attempt — the
  # default threshold of 5 would blacklist the owner within a few loads.
  printf 'network:\n  interface: %s\n  websocket_port: %s\n  ssl:\n    require_ssl: false\nsecurity:\n  brute_force_protection:\n    blacklist_threshold: 100\n    blacklist_timeout: 10\n' "$iface" "$GUI_BOXWEB" > "$rootfs/root/.vnc/kasmvnc.yaml"
  # xstartup: what KasmVNC's vncserver execs once X is up. xfce4-session brings up its own bus; Plasma does NOT, so it
  # gets a session bus wrapped around it. With no GPU socket, Plasma is told to skip compositing and put QML on
  # QPainter — on llvmpipe that is the difference between a desktop and a slideshow. (KWIN_COMPOSE=N is the X11
  # 'no compositing' value; Q/QPainter is Wayland-only and would be silently ignored here.)
  { printf '#!/bin/sh\nxset s off -dpms s noblank 2>/dev/null\nxsetroot -solid "#000000" 2>/dev/null\n'
    if [ "$de" = kde ]; then
      printf 'export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=KDE DESKTOP_SESSION=plasma\n'
      [ -z "$sock" ] && printf 'export KWIN_COMPOSE=N QT_QUICK_BACKEND=software\n'
      printf 'command -v dbus-run-session >/dev/null 2>&1 && exec dbus-run-session -- %s\nexec dbus-launch --exit-with-session %s\n' "$sess" "$sess"
    else printf 'exec xfce4-session\n'; fi
  } > "$rootfs/root/.vnc/xstartup"
  chmod +x "$rootfs/root/.vnc/xstartup"; : > "$rootfs/root/.vnc/.de-was-selected"
  # config.yaml (0600) is the ONLY secret file: it holds the shared password. The run script reads it from there so no
  # secret rides on argv. Geometry is expanded HOST-side (AGENTBOX_* is stripped from the box env).
  ( umask 077; { echo "bind-addr: $iface:$GUI_BOXCODE"; echo "auth: password"; echo "password: $pw"; echo "cert: false"; } > "$rootfs/root/.config/code-server/config.yaml" )
  geo="${AGENTBOX_GUI_GEOMETRY:-1440x900}"; tgt=$(wtarget); [ "$mnt" = none ] && tgt=/root
  # With the socket in place, every X client in the session renders through it (xfwm, chromium, GL apps). Empty when
  # off — which just leaves a blank line in the generated script.
  [ -n "$sock" ] && gpuenv='export GALLIUM_DRIVER=virpipe MESA_GL_VERSION_OVERRIDE=4.0 VTEST_SOCKET_NAME=/tmp/.virgl_test'
  # chromium's flags are baked into /etc/chromium.d/agentbox at BUILD time; rewrite them each launch so toggling GPU=
  # takes effect without a rebuild. --ignore-gpu-blocklist is needed because chromium blocklists the virgl renderer.
  [ -d "$rootfs/etc" ] && { mkdir -p "$rootfs/etc/chromium.d"
    printf 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-dev-shm-usage %s"\n' \
      "$([ -n "$sock" ] && printf -- '--ignore-gpu-blocklist' || printf -- '--disable-gpu')" > "$rootfs/etc/chromium.d/agentbox"; }
  { cat <<EOS
#!/bin/bash
export HOME=/root
PW=\$(sed -n 's/^password: //p' /root/.config/code-server/config.yaml 2>/dev/null | head -1)
[ -n "\$PW" ] && printf '%s\n%s\n' "\$PW" "\$PW" | timeout 15 vncpasswd -u agent -w -o >/dev/null 2>&1 || true
export XDG_RUNTIME_DIR="/tmp/runtime-\$(id -u)"; mkdir -p "\$XDG_RUNTIME_DIR"; chmod 700 "\$XDG_RUNTIME_DIR"
$gpuenv
vncserver -kill :1 >/dev/null 2>&1 || true
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
vncserver :1 -geometry "$geo" -depth 24 -noreset || exit 1
EOS
    # RFB=1: x11vnc exports the SAME display :1 as plain VNC, so the browser client and a native viewer drive one
    # desktop. It needs its own password file (the classic DES format, which KasmVNC's own auth no longer uses); if
    # that file didn't get written we do NOT start — better no port at all than an unauthenticated one. The marker
    # files are the launch summary's source of truth, so it can never claim a port that isn't listening.
    [ "$rfb" = 1 ] && cat <<EOS
(umask 077; rm -f /root/.vnc/x11vnc.pass    # delete first: a stale file would open the port on LAST launch's password
 x11vnc -storepasswd "\$PW" /root/.vnc/x11vnc.pass >/dev/null 2>&1)
XA=; [ -f /root/.Xauthority ] && XA="-auth /root/.Xauthority"
if [ -s /root/.vnc/x11vnc.pass ] && x11vnc -display :1 \$XA -rfbport $GUI_BOXRFB $rfbbind \\
     -rfbauth /root/.vnc/x11vnc.pass -forever -shared -bg -q -o /tmp/x11vnc.log >/dev/null 2>&1; then
  sleep 1
  if command -v pgrep >/dev/null 2>&1 && ! pgrep -x x11vnc >/dev/null 2>&1; then : > /root/.rfb.fail; else : > /root/.rfb.ok; fi
else : > /root/.rfb.fail; fi
EOS
    [ "$mitm" = 1 ] && cat <<'EOS'
mitmweb --mode regular --listen-host 127.0.0.1 --listen-port 8082 --web-host 127.0.0.1 --web-port 8083 --set web_open_browser=false >/tmp/mitmweb.log 2>&1 &
for i in $(seq 1 15); do [ -f "$HOME/.mitmproxy/mitmproxy-ca-cert.pem" ] && break; sleep 1; done
if [ -f "$HOME/.mitmproxy/mitmproxy-ca-cert.pem" ]; then
  mkdir -p "$HOME/.pki/nssdb"
  certutil -d sql:"$HOME/.pki/nssdb" -L >/dev/null 2>&1 || certutil -d sql:"$HOME/.pki/nssdb" -N --empty-password
  certutil -d sql:"$HOME/.pki/nssdb" -A -t "C,," -n mitmproxy -i "$HOME/.mitmproxy/mitmproxy-ca-cert.pem" 2>/dev/null
  cp "$HOME/.mitmproxy/mitmproxy-ca-cert.pem" /usr/local/share/ca-certificates/mitmproxy.crt 2>/dev/null && update-ca-certificates >/dev/null 2>&1 || true
  mkdir -p /etc/chromium.d
  printf 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --proxy-server=127.0.0.1:8082 --proxy-bypass-list=localhost,127.0.0.1"\n' > /etc/chromium.d/agentbox-mitm
fi
EOS
    if [ "$app" = browser ]; then cat <<'EOS'
export DISPLAY=:1
CH=$(command -v chromium chromium-browser 2>/dev/null | head -1)
[ -n "$CH" ] && "$CH" --start-maximized about:blank >/dev/null 2>&1 &
exec sleep infinity
EOS
    else printf 'exec code-server --bind-addr %s:%s %s\n' "$iface" "$GUI_BOXCODE" "$tgt"; fi
  } > "$rootfs/root/.boxgui-run.sh"
  chmod +x "$rootfs/root/.boxgui-run.sh"
  [ "$(wakestat)" = on ] || wakeon || true
  # Launch via bash -c '…"$2"…' _ "$alias" "$PWD" "$tgt": the host path arrives as argv, expanded once, so any
  # space/$/quote/backtick in it stays literal (no re-parsed launch-script path). The GPU socket is a 4th, optional
  # bind, spliced in with printf %q (it IS re-parsed, so it must arrive already quoted).
  # ONLY the socket is bound — not the whole $TMPDIR (--shared-tmp), which would shadow the box's own /tmp (hiding the
  # Xvnc socket) and hand the box read/write over the host tmp dir.
  [ -n "$sock" ] && gbind=$(printf -- '--bind %q:/tmp/.virgl_test' "$sock")
  if [ "$mnt" = none ]; then
    tmux new -ds ab-boxgui bash -c 'exec proot-distro login "$1" --isolated '"$gbind"' -- bash /root/.boxgui-run.sh' _ "$alias"
  else
    tmux new -ds ab-boxgui bash -c 'exec proot-distro login "$1" --isolated --bind "$2:$3" '"$gbind"' -- bash /root/.boxgui-run.sh' _ "$alias" "$PWD" "$tgt"
  fi
  sleep 3
  tmux has-session -t "=ab-boxgui" 2>/dev/null \
    || { msg "box desktop exited immediately — rebuild the box: ab remove $prof && ab $prof" "$R"; return 1; }
  mkdir -p "$STATE"; printf '%s' "$prof" > "$STATE/boxgui.prof"
  # RFB=1: the in-box script writes its verdict only once Xvnc is up, which can land a few seconds past the sleep above.
  [ "$rfb" = 1 ] && for i in $(seq 1 10); do
    { [ -e "$rootfs/root/.rfb.ok" ] || [ -e "$rootfs/root/.rfb.fail" ]; } && break; sleep 1; done
  [ "$mnt" = none ] && msg "box desktop '$prof' started — SEALED (no folder bound):" "$G" \
    || msg "box desktop '$prof' started — scoped to $(short "$PWD") (opens as $tgt):" "$G"
  kv "  desktop (KasmVNC)" "http://localhost:$GUI_BOXWEB  (login user: agent)" "$G"
  # Plasma is a lot fussier than xfce under proot, so say where its log is BEFORE it's needed — a session that dies
  # after Xvnc came up shows as a black desktop, not as a failed launch (the tmux session is still there either way).
  [ "$de" = kde ] && kv "  session" "KDE Plasma$([ -z "$sock" ] && printf -- ' — compositing off, QML on QPainter (no GPU; GPU=virgl turns the effects back on)')  ·  black screen? see /root/.vnc/*:1.log in the box" "$G"
  [ "$lan" = 1 ] && { lip=$(lanips | awk '{print $1}'); [ -n "$lip" ] && kv "  on your LAN" "http://$lip:$GUI_BOXWEB  (anyone on this Wi-Fi, same password)" "$Y"; }
  if [ "$rfb" = 1 ]; then
    if [ -e "$rootfs/root/.rfb.ok" ]; then
      kv "  native VNC (RFB)" "127.0.0.1:$GUI_BOXRFB  — same desktop, for a viewer with a trackpad mode" "$G"
      kv "  ↳ trackpad mode" "AVNC: Settings → Gesture style → Touchpad  ·  bVNC: input mode → Simulated Touchpad" "$G"
      [ "$lan" = 1 ] && [ -n "$lip" ] && kv "  ↳ on your LAN" "$lip:$GUI_BOXRFB  (anyone on this Wi-Fi — and VNC auth is 8-char DES, weaker than the web login)" "$Y"
    else kv "  native VNC (RFB)" "asked for, but x11vnc isn't running — web desktop only (why: the warning above, or /tmp/x11vnc.log in the box)" "$Y"; fi
  fi
  [ "$app" = browser ] && kv "  browser" "chromium (opens in the desktop; reopen from the menu if closed)" "$G" \
    || kv "  VS Code" "http://localhost:$GUI_BOXCODE" "$G"
  [ "$mitm" = 1 ] && kv "  mitmweb UI" "http://localhost:8083 (open in the box browser)" "$Y"
  [ "$gpu" = virgl ] && { [ -n "$sock" ] \
    && kv "  GPU" "virgl → the phone's GPU (check in a desktop terminal: glxinfo -B)" "$G" \
    || kv "  GPU" "virgl asked for but unavailable — running on CPU (llvmpipe)" "$Y"; }
  # One password for every door. Classic VNC auth (the RFB port) is DES over the first 8 characters only — say so
  # rather than let a 16-char password look like it was rejected/truncated by the viewer.
  [ "$rfb" = 1 ] && [ -e "$rootfs/root/.rfb.ok" ] \
    && kv "  password (all 3)" "$pw   (the RFB port reads only its first 8 characters — type the whole thing)" "$G" \
    || kv "  password (both)" "$pw" "$G"
  kv "  close it" "ab stop  (keeps the box; reopen with ab $prof)" "$Y"
  kv "  rebuild fresh" "ab remove $prof  (delete, then ab $prof)" "$Y"; return 0; }
# Every box gets a colourful interactive shell: colour ls/grep + a colour prompt, TERM defaulted to 256-colour. Written
# host-side into the rootfs (idempotent) so it also fixes EXISTING boxes on the next launch — no rebuild needed.
boxcolour(){ local r="$1"; [ -d "$r/etc" ] || return 0; mkdir -p "$r/etc/profile.d"
  cat > "$r/etc/profile.d/agentbox-colour.sh" <<'ABC'
export TERM="${TERM:-xterm-256color}"
alias ls='ls --color=auto'
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '
ABC
  # /etc/bash.bashrc is sourced by interactive non-login shells (what a box's `exec bash` is); point it at the file above.
  grep -q agentbox-colour "$r/etc/bash.bashrc" 2>/dev/null \
    || printf '\n[ -f /etc/profile.d/agentbox-colour.sh ] && . /etc/profile.d/agentbox-colour.sh  # agentbox-colour\n' >> "$r/etc/bash.bashrc"; }
# `ab <name> [cmd]` — build box <name> from its profile if missing, then run it scoped to the cwd.
abox(){ local prof="$1"; shift; local cmd="$*" cf alias rootfs \
    INSTALL= TOKENS= RUN= MOUNT=cwd EPHEMERAL=0 DESKTOP= APP=code MITM=0 LAN=0 RFB=0 GPU= AGENT= PKGS= DIST= ef efn rc tgt run incmd mitmblock= ms=
  case "$prof" in host-*)                                        # host-* is a host tmux session, never a box (no profile, no proot)
    case "$cmd" in -*) msg "'$cmd' is a flag, not a command — a host shell has no RUN to attach it to (ab $prof <cmd> $cmd)" "$R"; return 1;; esac
    if [ -t 1 ] && [ -z "${TMUX:-}" ] && [ "${AB_NO_SESSION:-}" != 1 ] && sesscmd "$cmd"; then sessrun "$prof" "$@"; return $?; fi
    if [ -n "$cmd" ]; then exec "${SHELL:-bash}" -lc "$cmd"; else exec "${SHELL:-bash}" -l; fi;;
  esac
  cf=$(aboxconf "$prof"); alias=$(aboxalias "$prof")
  if [ -f "$cf" ]; then                                         # existing copy: warn if the pristine template moved past it
    local cv tv src="$TPL/$prof.conf"; cv=$(tplver "$cf"); tv=$(tplver "$src" 2>/dev/null)
    [ -n "$cv" ] && [ -n "$tv" ] && [ "$cv" != "$tv" ] \
      && msg "note: $(short "$cf") is from the $prof template v$cv; the current template is v$tv — it changed since, worth a look" "$Y"
  else aboxnewok "$prof" || return 1                            # unknown name → confirm (Enter = yes) before creating anything
    mkdir -p "$(dirname "$cf")"; aboxdefault "$cf" "$prof" || return 1
    case " run save restore remove rm rebuild upgrade stop ps pw pkg setup update sync session help version ls list " in
      *" $prof "*) msg "note: '$prof' is also an ab command — run this box with 'ab run $prof' ('ab $prof' triggers the command instead)" "$Y";; esac
    msg "new profile $(short "$cf") — binds only the launch folder, injects only its tokens (edit it directly)" "$Y"; fi
  # After the profile step, so a mistyped name never triggers a package install (nothing above this needs proot-distro).
  has proot-distro || pkg install -y proot-distro || { msg "proot-distro install failed" "$R"; return 1; }
  . "$cf"; mkenv
  # What actually runs in the box. A cmd REPLACES the profile's RUN — except one that starts with a flag, which is
  # added to it: `ab claude --continue`, not `ab claude claude --continue`. A flag can't be a program name, so there
  # is nothing ambiguous about the two cases. (Computed here, before the session decision, so both agree on it.)
  case "$cmd" in
    -*) [ -n "$RUN" ] || { msg "'$prof' has no RUN for '$cmd' to attach to — name the command: ab $prof <cmd> $cmd" "$R"; return 1; }
        run="$RUN$(printf ' %q' "$@")";;   # %q per ARG here (unlike the replace case below, which is a flat string):
                                            # these are flags and their values, so `ab claude -p "two words"` stays ONE argument
    *)  run="${cmd:-$RUN}";;
  esac
  # Auto-session: an interactive CLI box opens a fresh tmux session each launch (survives ssh-drop; reattach earlier
  # ones with 'ab session'). No cmd → always, whatever RUN is. A cmd → only when it is one you SIT in (see sesscmd),
  # so `ab claude bash` gets a session exactly like `ab claude` does. Piped output / already in tmux / desktop box →
  # foreground. Never: AB_NO_SESSION=1; always (any cmd): AB_SESSION=1.
  if [ -z "$DESKTOP" ] && [ -t 1 ] && [ -z "${TMUX:-}" ] && [ "${AB_NO_SESSION:-}" != 1 ] \
     && { [ -z "$cmd" ] || sesscmd "$run"; }; then
    sessrun "$prof" "$@"; return $?
  fi
  # Build when missing; a non-desktop EPHEMERAL box rebuilds fresh each run (desktop boxes only when missing — too heavy).
  if { [ -z "$DESKTOP" ] && [ "$EPHEMERAL" = 1 ]; } || [ -z "$(pdroot "$alias")" ]; then
    { [ -z "$DESKTOP" ] && [ "$EPHEMERAL" = 1 ] && [ -n "$(pdroot "$alias")" ]; } && { aboxguard "$prof"; aboxdrop "$alias"; }
    aboxbuild "$prof" || return 1
  fi
  rootfs=$(pdroot "$alias"); [ -n "$rootfs" ] || { msg "box '$prof' not built" "$R"; return 1; }
  boxcolour "$rootfs"                                            # colour the box's shell (ls/grep/prompt + 256-colour TERM)
  case "${GPU:-}" in ''|virgl) :;;                               # GPU= is desktop-only and has exactly one value today
    *) msg "profile '$prof': unknown GPU='$GPU' (use virgl, or leave it empty for CPU) — ignoring" "$Y"; GPU=;; esac
  [ -n "$GPU" ] && [ -z "$DESKTOP" ] && { msg "note: GPU=$GPU applies to a DESKTOP box only — ignored here" "$Y"; GPU=; }
  case "${RFB:-0}" in ''|0) RFB=0;; 1) :;;                       # RFB= is desktop-only and is a plain on/off
    *) msg "profile '$prof': RFB must be 0 or 1 (got '$RFB') — ignoring" "$Y"; RFB=0;; esac
  [ "$RFB" = 1 ] && [ -z "$DESKTOP" ] && { msg "note: RFB=1 applies to a DESKTOP box only — ignored here" "$Y"; RFB=0; }
  case "${DESKTOP:-}" in ''|xfce|kde|plasma|KDE|Plasma) :;;      # DESKTOP= names the session, and only these two exist
    *) msg "profile '$prof': DESKTOP='$DESKTOP' isn't a session ab knows (xfce|kde) — building/running it as xfce" "$Y";; esac
  # DESKTOP set → run a scoped desktop (background); nothing after this runs for a GUI box.
  [ -n "$DESKTOP" ] && { aboxgui "$prof" "$alias" "$rootfs" "$APP" "$MOUNT" "$MITM" "$LAN" "$GPU" "$RFB" "$DESKTOP"; return $?; }
  [ "$MITM" = 1 ] && ms='; mitm on'
  ef="$rootfs/root/.abenv.$$"; efn=".abenv.$$"     # token file lives inside the isolated rootfs; nothing else is bound
  ( umask 077; aboxenv "$TOKENS" > "$ef" )
  if [ "$MITM" = 1 ]; then mitmblock='mitmweb --mode regular --listen-host 127.0.0.1 --listen-port 8082 --web-host 127.0.0.1 --web-port 8083 --set web_open_browser=false >/tmp/mitmweb.log 2>&1 &
for i in $(seq 1 15); do [ -f "$HOME/.mitmproxy/mitmproxy-ca-cert.pem" ] && break; sleep 1; done
[ -f "$HOME/.mitmproxy/mitmproxy-ca-cert.pem" ] && { cp "$HOME/.mitmproxy/mitmproxy-ca-cert.pem" /usr/local/share/ca-certificates/mitmproxy.crt 2>/dev/null && update-ca-certificates >/dev/null 2>&1; } || true
export NODE_EXTRA_CA_CERTS=$HOME/.mitmproxy/mitmproxy-ca-cert.pem HTTP_PROXY=http://127.0.0.1:8082 HTTPS_PROXY=http://127.0.0.1:8082
'; fi
  # source+delete the token file, run the (optional) mitm setup, then exec RUN in the working dir; $1 = in-box start dir.
  incmd='set -a; . /root/'"$efn"' 2>/dev/null; rm -f /root/'"$efn"'; set +a; export HOME=/root TERM="${TERM:-xterm-256color}"; cd "$1"; '"$mitmblock"'exec '"${run:-bash}"
  if [ "${MOUNT:-cwd}" = none ]; then
    msg "box '$prof' — SEALED (no folder bound); tokens: ${TOKENS:-none}; running: ${run:-bash}$ms" "$G"
    proot-distro login "$alias" --isolated -- bash -c "$incmd" _ /root
  else
    tgt=$(wtarget)
    case "$PWD/" in "$HOME"/) msg "note: launched from your home — the box would see all of it; cd into a project folder for tight scoping" "$Y";; esac
    msg "box '$prof' — sees ONLY $(short "$PWD") (as $tgt); tokens: ${TOKENS:-none}; running: ${run:-bash}$ms" "$G"
    proot-distro login "$alias" --isolated --bind "$PWD:$tgt" -- bash -c "$incmd" _ "$tgt"
  fi
  rc=$?; rm -f "$ef" 2>/dev/null
  [ "$EPHEMERAL" = 1 ] && [ -z "$DESKTOP" ] && { aboxdrop "$alias"; msg "ephemeral box '$prof' removed (rebuilds next launch)" "$G"; }
  return $rc; }
# `ab` / `ab ls` — every box (built or profile-only) + templates + snapshots, one picture.
boxls(){ local f prof n=0 sn=0 tpl
  for f in "$VC"/profile/*.conf; do [ -e "$f" ] || break
    prof=$(basename "$f" .conf); n=$((n+1))
    [ -n "$(pdroot "$(aboxalias "$prof")")" ] && st "$prof" "built · ab $prof" "$G" \
      || st "$prof" "profile · ab $prof builds it" "$Y"
  done
  [ "$n" -eq 0 ] && st "boxes" "none yet · ab claude scopes an agent here" "$Y"
  tpl=$(aboxtemplates); [ -n "$tpl" ] && st "templates" "$tpl   (ab <name> to create)" "$DM"
  for f in "$STATE"/box-snapshot-*.tar.gz; do [ -e "$f" ] || break
    prof=$(basename "$f" .tar.gz); prof=${prof#box-snapshot-}
    st "snapshot $prof" "$(du -h "$f" | cut -f1) · $(date -r "$f" '+%Y-%m-%d %H:%M')" "$G"; sn=$((sn+1)); done
  [ "$sn" -eq 0 ] && st "snapshots" "none · ab save <name>" "$DM"; return 0; }
# `ab remove <name>` — stop its desktop if running, delete rootfs + snapshot; then ask whether to delete the profile conf.
boxremove(){ local prof="${1:-}" a snap cf; [ -n "$prof" ] || { msg "which box? ab remove <name>" "$Y"; return 1; }
  aboxguard "$prof"; a=$(aboxalias "$prof"); snap="$STATE/box-snapshot-$prof.tar.gz"
  [ -n "$(pdroot "$a")" ] && { aboxdrop "$a"; msg "box '$prof' rootfs removed" "$G"; } || msg "no built box for '$prof'" "$Y"
  [ -f "$snap" ] && { rm -f "$snap"; msg "snapshot for '$prof' deleted" "$G"; }
  cf=$(aboxconf "$prof")
  if [ -f "$cf" ]; then printf 'delete profile %s too? [y/N] ' "$(short "$cf")"; read -r a || a=
    case "$a" in y|Y|yes|YES) rm -f "$cf"; msg "profile $(short "$cf") deleted" "$G";; *) msg "profile $(short "$cf") kept" "$Y";; esac
  fi; return 0; }

# ── Package helper (simple-mode profiles) ──────────────────────────
# `ab pkg <name> search <term>` lists matches from the built box's apt catalog and then offers to add + apply them
# (see pkgoffer); `add`/`rm <pkg…>` edit the profile's PKGS= line; bare/ls prints it. Docker-mode profiles (INSTALL
# set) ignore PKGS — a note is shown.
abpkg(){ local prof="${1:-}" verb cf a cur new p tmp hits; [ $# -gt 0 ] && shift; verb="${1:-ls}"; [ $# -gt 0 ] && shift
  cf=$(aboxconf "$prof"); a=$(aboxalias "$prof")
  [ -n "$prof" ] || { msg "usage: ab pkg <name> [ls | add <pkg…> | rm <pkg…> | search <term>]" "$Y"; return 1; }
  case "$verb" in
    search) [ -n "${1:-}" ] || { msg "usage: ab pkg $prof search <term>" "$Y"; return 1; }
      [ -n "$(pdroot "$a")" ] || { msg "build '$prof' first (ab $prof) — search reads its apt catalog" "$Y"; return 1; }
      hits=$(proot-distro login "$a" -- sh -c 'apt-cache search -- "$1" 2>/dev/null | sort | head -40' _ "$1")
      [ -n "$hits" ] || { msg "no match for '$1' in '$prof' apt catalog (it may be pip/npm-only, or the lists are stale — ab upgrade $prof)" "$Y"; return 1; }
      printf '%s\n' "$hits"
      [ -f "$cf" ] || { msg "no profile '$prof' — nothing to add it to" "$Y"; return 0; }
      pkgoffer "$prof" "$1" "$hits";;
    add|rm) [ -n "${1:-}" ] || { msg "usage: ab pkg $prof $verb <pkg…>" "$Y"; return 1; }
      [ -f "$cf" ] || { msg "no profile '$prof' yet — create it: ab $prof" "$Y"; return 1; }
      [ -n "$( . "$cf" 2>/dev/null; printf %s "$INSTALL" )" ] && msg "note: '$prof' is docker mode (INSTALL set) — PKGS is ignored" "$Y"
      cur=$( . "$cf" 2>/dev/null; printf %s "$PKGS" )
      if [ "$verb" = add ]; then new="$cur $*"; else new=" $cur "; for p in "$@"; do new="${new//" $p "/ }"; done; fi
      new=$(printf %s "$new" | tr ' ' '\n' | awk 'NF&&!s[$0]++' | paste -sd' ' -)
      if grep -q '^PKGS=' "$cf"; then tmp=$(mktemp); sed "s|^PKGS=.*|PKGS=\"$new\"|" "$cf" > "$tmp" && mv "$tmp" "$cf"
      else printf 'PKGS="%s"\n' "$new" >> "$cf"; fi
      msg "PKGS = ${new:-(empty)} · apply in place: ab upgrade $prof  (or a clean rebuild: ab rebuild $prof)" "$G";;
    ls|"") [ -f "$cf" ] || { msg "no profile '$prof' yet" "$Y"; return 1; }
      kv "$prof PKGS" "$( . "$cf" 2>/dev/null; printf %s "${PKGS:-(none)}")";;
    *) msg "usage: ab pkg <name> [ls | add <pkg…> | rm <pkg…> | search <term>]" "$Y"; return 1;;
  esac; }

# After a search, close the loop instead of leaving the two steps that matter to hand-typing. pkgoffer names the
# package the term points at, adds what belongs BESIDE it but is not a dependency of it (a python3-* library depends
# on python3 and never on pip — install openpyxl alone and the box still can't `pip install` the next one), states
# what each one is IN THE BOX RIGHT NOW from apt's own policy (new · a → b upgrade · current), and offers to write
# them into PKGS and apply them with `ab upgrade`. Already installed is NOT a reason to go quiet: a newer candidate
# is exactly the case worth offering, so the prompt appears whenever anything would be installed, upgraded, or is
# missing from PKGS. Enter/y does it, n prints the command and changes nothing, no terminal → print only (a search
# in a script must not silently mutate a box; AB_YES=1 is the explicit opt-in). Docker-mode profiles are told to edit
# INSTALL= instead — offering PKGS there would promise something the build ignores.
pkgmates(){ case "${1:-}" in                    # what belongs beside a package but isn't pulled in by it — certain cases only
    python3-*) printf 'python3 python3-pip';;
    ruby-*)    printf 'ruby';;
    php-*)     printf 'php-cli';;
  esac; }
pkgpick(){ local term="$1" names="$2" n best=   # exact name > python3-<term> > shortest name containing the term (-doc/-dev lose)
  case " $names " in *" $term "*) printf %s "$term"; return;; esac
  case " $names " in *" python3-$term "*) printf %s "python3-$term"; return;; esac
  for n in $names; do case "$n" in *"$term"*) { [ -z "$best" ] || [ "${#n}" -lt "${#best}" ]; } && best="$n";; esac; done
  printf %s "${best:-${names%% *}}"; }
pkgoffer(){ local prof="$1" term="$2" hits="$3" t="${AGENTBOX_TTY:-/dev/tty}" a cf cur names cand want keep= out pol p i c todo=0 miss= nins ans
  cf=$(aboxconf "$prof")
  [ -n "$( . "$cf" 2>/dev/null; printf %s "$INSTALL" )" ] \
    && { msg "'$prof' is docker mode (INSTALL set) — PKGS is ignored; put the install step in INSTALL= yourself" "$Y"; return 0; }
  a=$(aboxalias "$prof"); names=$(printf '%s\n' "$hits" | awk '{print $1}' | paste -sd' ' -)
  cand=$(pkgpick "$term" "$names")
  want=$(printf '%s %s' "$(pkgmates "$cand")" "$cand" | tr ' ' '\n' | awk 'NF&&!s[$0]++' | paste -sd' ' -)
  # ONE trip into the box for both answers: per-package state (policy) and how big the install really is (simulate).
  out=$(proot-distro login "$a" -- sh -c 'apt-cache policy -- "$@" 2>/dev/null; echo @@; apt-get install -s -y -- "$@" 2>/dev/null' _ $want)
  pol=$(printf '%s\n' "${out%%@@*}" | awk '/^[^ ]+:$/{n=substr($0,1,length($0)-1)} /^ *Installed:/{i=$2} /^ *Candidate:/{print n"\t"i"\t"$2}')
  nins=$(printf '%s\n' "${out#*@@}" | grep -c '^Inst ')
  printf '\n'; kv "$prof would add" "$want" "$BD"
  for p in $want; do case $'\n'"$pol" in *$'\n'"$p"$'\t'*) keep="$keep $p";; *) kv "  $p" "unknown to this box's apt — skipped" "$R";; esac; done
  want="${keep# }"; [ -n "$want" ] || { msg "nothing addable" "$Y"; return 1; }
  while IFS=$'\t' read -r p i c; do [ -n "$p" ] || continue                    # herestring, not a pipe: todo must survive the loop
    if [ "$i" = "(none)" ]; then kv "  $p" "$c · new" "$G"; todo=1
    elif [ "$i" != "$c" ]; then kv "  $p" "$i → $c · upgrade" "$G"; todo=1
    else kv "  $p" "$i · current" "$DM"; fi
  done <<< "$pol"
  [ "${nins:-0}" -gt 0 ] && kv "apt would install" "$nins package(s), dependencies included"
  cur=$( . "$cf" 2>/dev/null; printf %s "$PKGS" )
  for p in $want; do case " $cur " in *" $p "*) ;; *) miss=1;; esac; done
  [ -z "$miss" ] && [ "$todo" = 0 ] && { msg "already in PKGS and current — nothing to do" "$DM"; return 0; }
  msg "  (ab upgrade also apt-upgrades the rest of the box; the desktop stack is untouched)" "$DM"
  if [ "${AB_YES:-}" = 1 ]; then ans=y
  elif ( : < "$t" ) 2>/dev/null; then
    printf "%sadd to '%s' PKGS and upgrade the box now? [Y/n] %s" "$Y" "$prof" "$Z" > "$t"; IFS= read -r ans < "$t" || ans=n
  else msg "to apply: ab pkg $prof add $want && ab upgrade $prof" "$DM"; return 0; fi
  case "$ans" in [NnQq]*) msg "not added — ab pkg $prof add $want && ab upgrade $prof" "$Y"; return 0;; esac
  abpkg "$prof" add $want && boxupgrade "$prof"; }

# ── Snapshot / golden image ────────────────────────────────────────
# Golden image of a box rootfs (SYSTEM state only — your folders live outside and are untouched). Stored host-side in
# $STATE. Restore = factory reset in minutes, nothing re-downloaded.
boxbusy(){ local r="${1:-}"; [ -n "$r" ] && pgrep -f "$r" >/dev/null 2>&1; }   # empty r → not busy (never match-all)
boxsave(){ snapshot "${1:-}" make; }
boxrestore(){ snapshot "${1:-}" restore; }
snapshot(){ local prof="${1:-}" verb="${2:-status}" rootfs snapfile par base a
  [ -n "$prof" ] || { msg "which box? ab save <name> | ab restore <name>" "$Y"; return 1; }
  rootfs=$(pdroot "$(aboxalias "$prof")"); snapfile="$STATE/box-snapshot-$prof.tar.gz"
  case "$verb" in
    make|save)
      { [ -n "$rootfs" ] && [ -d "$rootfs" ]; } || { msg "no '$prof' box yet (ab $prof)" "$Y"; return 1; }
      boxbusy "$rootfs" && { msg "'$prof' box processes are running — stop them first (ab session kill)" "$Y"; return 1; }
      par=$(dirname "$rootfs"); base=$(basename "$rootfs"); mkdir -p "$STATE"
      msg "snapshotting '$prof' → $(short "$snapfile") (a few minutes on phone flash)…" "$G"
      ( umask 077; tar -czf "$snapfile.tmp" -C "$par" "$base" ) \
        || { rm -f "$snapfile.tmp"; msg "snapshot failed (see tar errors above)" "$R"; return 1; }
      chmod 600 "$snapfile.tmp" 2>/dev/null; mv -f "$snapfile.tmp" "$snapfile"
      msg "snapshot done: $(short "$snapfile") ($(du -h "$snapfile" | cut -f1)) — restore any time: ab restore $prof" "$G";;
    restore)
      [ -s "$snapfile" ] || { msg "no '$prof' snapshot yet — make one first: ab save $prof" "$Y"; return 1; }
      [ -n "$rootfs" ] || { msg "no '$prof' box to restore into — build it first: ab $prof" "$Y"; return 1; }
      boxbusy "$rootfs" && { msg "'$prof' box processes are running — stop them first (ab session kill)" "$Y"; return 1; }
      aboxguard "$prof"; par=$(dirname "$rootfs"); base=$(basename "$rootfs")
      # The archive's top-level dir must match the current rootfs basename, or extraction would land beside the (deleted)
      # rootfs and leave the box gone — verify BEFORE the destructive rm, so a mismatch aborts cleanly.
      case "$(tar -tzf "$snapfile" 2>/dev/null | head -1)" in
        "$base"/*|"$base") : ;;
        *) msg "snapshot layout doesn't match this box's rootfs dir ('$base') — remake it: ab save $prof" "$R"; return 1;; esac
      msg "this REPLACES the '$prof' box system with the snapshot from $(date -r "$snapfile" '+%Y-%m-%d %H:%M')" "$Y"
      printf 'restore? [y/N] '; read -r a
      case "$a" in [Yy]*) :;; *) msg "cancelled" "$Y"; return 1;; esac
      msg "restoring (a few minutes)…" "$G"
      rm -rf "$rootfs" && tar -xzf "$snapfile" -C "$par" \
        || { msg "restore FAILED midway — the box may be broken; re-run restore, or rebuild it (ab remove $prof && ab $prof)" "$R"; return 1; }
      msg "'$prof' box restored to the snapshot state" "$G";;
    ""|status) if [ -s "$snapfile" ]; then
        msg "snapshot ($prof): $(short "$snapfile") ($(du -h "$snapfile" | cut -f1), made $(date -r "$snapfile" '+%Y-%m-%d %H:%M')) — ab restore $prof" "$G"
      else msg "no '$prof' snapshot — after a good build: ab save $prof (= a factory-reset point)" "$Y"; fi;;
    *) msg "use: ab save <name> | ab restore <name>" "$Y"; return 1;; esac; }

# ── Desktop install script (shared by aboxbuild for DESKTOP=xfce boxes) ──
gui_randpw(){ head -c 24 /dev/urandom | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | cut -c1-16; }   # bounded, can't hang
# Emit the desktop-stack install script (session + chromium + KasmVNC + code-server) to $1. In-box args: KVER APP DE.
guiinstallscript(){ cat > "$1" <<'EOS'
#!/bin/bash
set -e
export DEBIAN_FRONTEND=noninteractive
KVER="${1:-1.4.0}"   # passed host-side (AGENTBOX_* is filtered out of the box env, so it can't be read here)
APP="${2:-code}"     # code = install code-server (VS Code) | browser = chromium only, skip code-server
DE="${3:-xfce}"      # xfce = minimal session + wm | kde = a full Plasma desktop (already normalised host-side)
apt-get update
# drop the old TigerVNC/noVNC stack if a previous install left it (KasmVNC replaces it)
apt-get purge -y tigervnc-standalone-server tigervnc-common novnc websockify >/dev/null 2>&1 || true
apt-get install -y --no-install-recommends \
  dbus-x11 x11-xserver-utils fonts-dejavu-core fonts-noto-cjk fonts-noto-color-emoji curl ca-certificates
if [ "$DE" = kde ]; then
  # Plasma is installed WITH recommends, the opposite of the xfce line below, and deliberately: a
  # --no-install-recommends Plasma tends to come up half-dressed (missing icon themes, QML bits, integration) and a
  # desktop that won't start is a far worse trade than a bigger download. plasma-workspace carries startplasma-x11,
  # the session entry point the launcher execs; kwin-x11 is the X11 window manager (kwin-wayland is useless here).
  apt-get install -y plasma-desktop plasma-workspace kwin-x11 systemsettings konsole breeze breeze-icon-theme
else
  # minimal xfce: session + window manager only — no panel/desktop/thunar/goodies (black root set in xstartup)
  apt-get install -y --no-install-recommends xfce4-session xfwm4
fi
# chromium: package name differs by distro (debian: chromium, ubuntu: chromium-browser)
apt-get install -y chromium 2>/dev/null || apt-get install -y chromium-browser || true
# chromium under proot has no sandbox namespaces and a tiny /dev/shm → bake safe flags for every launch
mkdir -p /etc/chromium.d
printf 'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --disable-gpu --disable-dev-shm-usage"\n' > /etc/chromium.d/agentbox
# KasmVNC: modern VNC with a built-in web client. Pick the .deb matching this distro codename + arch; fall back to bookworm.
. /etc/os-release; CN="${VERSION_CODENAME:-bookworm}"
case "$CN" in trixie|bookworm|bullseye|focal|jammy|noble|kali-rolling) : ;; *) CN=bookworm ;; esac
ARCH=$(dpkg --print-architecture)
DEB="kasmvncserver_${CN}_${KVER}_${ARCH}.deb"
if [ ! -d /usr/share/kasmvnc ]; then
  curl -fsSL -o "/tmp/$DEB" "https://github.com/kasmtech/KasmVNC/releases/download/v${KVER}/$DEB"
  apt-get install -y "/tmp/$DEB"; rm -f "/tmp/$DEB"
fi
# code-server (browser VS Code) — only for APP=code. The password is set later by aboxgui, not here.
if [ "$APP" = code ]; then command -v code-server >/dev/null 2>&1 || curl -fsSL https://code-server.dev/install.sh | sh; fi
[ "$DE" = kde ] && SESSBIN=/usr/bin/startplasma-x11 || SESSBIN=/usr/bin/startxfce4
echo "----------------------------------------"
echo "desktop  : $DE $([ -x "$SESSBIN" ] && echo "ok ($SESSBIN)" || echo MISSING)"
echo "kasmvnc  : $([ -d /usr/share/kasmvnc ] && echo "ok (v$KVER, $CN/$ARCH)" || echo MISSING)"
echo "chromium : $(command -v chromium chromium-browser 2>/dev/null | head -1 || echo MISSING)"
echo "code-srv : $([ "$APP" = code ] && { code-server --version 2>/dev/null | head -1 || echo unknown; } || echo 'skipped (browser-only)')"
[ -d /usr/share/kasmvnc ] || { echo "ERROR: KasmVNC did not install" >&2; exit 1; }
[ -x "$SESSBIN" ] || { echo "ERROR: the $DE session did not install ($SESSBIN missing)" >&2; exit 1; }
EOS
}

# ── Sessions (host tmux) + anti-sleep wakelock ─────────────────────
# Anti-sleep: termux-wake-lock keeps computing with the screen off / app switched. Auto-acquired when a session opens,
# auto-released when the last one ends. Marker: $STATE/wake.on.
wakeon(){ has termux-wake-lock || { msg "termux-wake-lock not found (ships with termux-tools)" "$R"; return 1; }
  termux-wake-lock && mkdir -p "$STATE" && : > "$STATE/wake.on" \
    && msg "wakelock acquired — keeps computing with the screen off (drains battery; released when all sessions end)" "$G"; }
wakeoff(){ termux-wake-unlock 2>/dev/null; rm -f "$STATE/wake.on"; msg "wakelock released — device returns to normal sleep" "$G"; }
wakestat(){ [ -f "$STATE/wake.on" ] && echo on || echo off; }
# ~/.tmux.conf tuned for TUI agents: mouse OFF (tmux mouse mode hijacks scroll/selection and breaks TUI input + copy),
# plus passthrough + extended keys so escapes / Shift+Enter reach the app. Idempotent managed block; backs up once.
tmuxconf(){ local f=~/.tmux.conf force="${1:-}"
  if grep -q '#AGENTBOX-TMUX v2' "$f" 2>/dev/null && [ "$force" != force ]; then return 0; fi
  [ -f "$f" ] && [ ! -f "$f.bak" ] && cp "$f" "$f.bak"
  [ -f "$f" ] && sed -i -e '/^#AGENTBOX-TMUX v2/,/^#AGENTBOX-TMUX-END/d' "$f" 2>/dev/null
  { printf '#AGENTBOX-TMUX v2 (managed) — terminal behaviour for TUI agents (mouse off = scroll/select/copy-paste work)\n'
    printf 'set -g mouse off\n'
    printf 'set -gq allow-passthrough on\n'
    printf 'set -sq extended-keys on\n'
    printf "set -asq terminal-features 'xterm*:extkeys'\n"
    printf '#AGENTBOX-TMUX-END\n'; } >> "$f"
  tmux info >/dev/null 2>&1 && tmux source-file "$f" 2>/dev/null
  [ "$force" != force ] || msg "tmux config applied → $f (mouse off, passthrough, extended keys; first run backs up to $f.bak)" "$G"
  return 0; }
# After an abrupt ssh DROP (not a clean tmux detach) the box's TUI leaves the OUTER terminal in mouse-report /
# bracketed-paste mode — tmux never got to restore it — so on reconnect you land at the HOST shell and every mouse move
# spills escape codes into the command line. Self-heal: a PROMPT_COMMAND that disables those modes before each host
# prompt (outside tmux only — inside, tmux + the app own that state; a no-op when nothing leaked, so it's invisible).
# Idempotent managed block in ~/.bashrc, plus a ~/.bash_profile bridge because ssh gives a LOGIN shell, which sources
# .bash_profile and SKIPS .bashrc — without the bridge the heal would never load over ssh (exactly the case that leaks).
hostheal(){ local rc=~/.bashrc bp=~/.bash_profile
  if ! grep -q '#AGENTBOX-HEAL v1' "$rc" 2>/dev/null; then
    [ -f "$rc" ] && [ ! -f "$rc.bak" ] && cp "$rc" "$rc.bak"
    [ -f "$rc" ] && sed -i -e '/^#AGENTBOX-HEAL/,/^#AGENTBOX-HEAL-END/d' "$rc" 2>/dev/null
    cat >> "$rc" <<'ABH'
#AGENTBOX-HEAL v1 (managed) — clear leaked mouse/paste modes at each host prompt after an ssh drop
if [ -n "$PS1" ] && [ -t 1 ] && [ -z "$TMUX" ]; then
  __ab_termheal(){ printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?2004l\033[?1004l\033[?25h'; }
  case ";$PROMPT_COMMAND;" in *";__ab_termheal;"*) :;; *) PROMPT_COMMAND="__ab_termheal${PROMPT_COMMAND:+;$PROMPT_COMMAND}";; esac
fi
#AGENTBOX-HEAL-END
ABH
  fi
  if ! grep -q 'agentbox-heal-bridge' "$bp" 2>/dev/null; then
    if [ ! -f "$bp" ]; then                                      # no .bash_profile → make one that keeps .profile working
      cat > "$bp" <<'ABB'
# agentbox-heal-bridge — login (ssh) shells skip ~/.bashrc; load ~/.profile then ~/.bashrc so the terminal heal applies
[ -f ~/.profile ] && . ~/.profile
[ -f ~/.bashrc ] && . ~/.bashrc
ABB
    elif ! grep -q '\.bashrc' "$bp"; then                        # it exists but never sources .bashrc → add a guarded line
      printf '\n[ -f ~/.bashrc ] && . ~/.bashrc  # agentbox-heal-bridge\n' >> "$bp"
    fi
  fi; return 0; }
needtmux(){ has tmux || pkg install -y tmux || { msg "tmux is required but not available" "$R"; return 1; }; tmuxconf; }
anysession(){ tmux ls -F '#S' 2>/dev/null | grep -q '^ab-'; }
# A session pane re-runs `bash "$SELF" …`; if the on-disk script won't parse, the pane dies the instant it starts —
# after we've grabbed the wakelock. Check first: fail loud, print the real parser message, don't touch the lock.
selfok(){ local e; e=$(bash -n "$SELF" 2>&1) && return 0
  msg "agentbox won't parse — not opening a session (fix the syntax error, or reinstall):" "$R"
  printf '%s\n' "$e" | while IFS= read -r l; do msg "  $l" "$Y"; done; return 1; }
# List/pick agentbox tmux sessions to reattach (mode=enter) or kill (mode=kill).
sesspick(){ local mode="${1:-enter}" names=() dates=() paths=() n cr path i c maxw=0 disp d
  # List EVERY tmux session (not just ab-*): agentbox's own — box · host-* · sync · boxgui, plus legacy ones that predate
  # the ab- prefix (e.g. an old 'sync-all') and anything you started yourself. The picker reattaches/kills your choice.
  # Two passes: gather rows + widest name, then print an aligned, coloured table (num · name · created · folder).
  while IFS=$'\t' read -r n cr path; do [ -n "$n" ] || continue
      names+=("$n"); paths+=("$path")
      d=$(date -d "@$cr" '+%Y-%m-%d %H:%M' 2>/dev/null); dates+=("${d:-—}")
      disp="${n#ab-}"; [ "${#disp}" -gt "$maxw" ] && maxw=${#disp}
    done < <(tmux ls -F "#S"$'\t'"#{session_created}"$'\t'"#{pane_current_path}" 2>/dev/null)
  [ ${#names[@]} -eq 0 ] && { msg "no tmux sessions — open one: ab session <name>" "$Y"; return 0; }
  for i in "${!names[@]}"; do disp="${names[i]#ab-}"
    printf '  %s%2d)%s %s%-*s%s  %s%s%s  %s\n' \
      "$CY" "$((i+1))" "$Z" "$BD" "$maxw" "$disp" "$Z" "$DM" "${dates[i]}" "$Z" "$(short "${paths[i]}")"
  done
  printf '%s which? [1-%s, q=cancel] ' "$([ "$mode" = kill ] && echo kill || echo reattach)" "${#names[@]}"; read -r c
  case "$c" in ''|q|Q) return 0;; *[!0-9]*) msg "enter a number" "$R"; return 1;; esac
  { [ "$c" -ge 1 ] && [ "$c" -le ${#names[@]} ]; } || { msg "out of range" "$R"; return 1; }
  n="${names[$((c-1))]}"
  if [ "$mode" = kill ]; then tmux kill-session -t "=$n" 2>/dev/null; msg "session '${n#ab-}' killed" "$G"
  else needtmux || return 1; tmux attach -t "=$n"; fi
  anysession || { [ "$(wakestat)" = on ] && wakeoff; }; return 0; }
# Simplified kebab-case of a path's last component (or a box name): lowercase, non-alnum → '-', collapsed/trimmed.
slug(){ local s; s=$(printf '%s' "${1##*/}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//'); printf '%s' "${s:-x}"; }
# Does this command deserve its own session? Only if it is one you SIT in — judged on its first word: a shell, a CLI
# agent, a REPL. Everything else stays in the foreground ON PURPOSE: a one-shot's output dies with the pane the
# instant it exits (tmux restores the screen), and `ab claude "npm test"` is output you want to read.
# The one-shot flag differs per family, and they collide — `bash -c …` is a one-shot while `claude -c` RESUMES a
# session, so the test is made inside each family, never across all of them. AB_SESSION=1 forces a session for any
# command; AB_NO_SESSION=1 (checked by the caller) never opens one.
sesscmd(){ local c="${1:-}" w
  [ -z "$c" ] && return 0
  [ "${AB_SESSION:-}" = 1 ] && return 0
  w=${c%%[[:space:]]*}; w=${w##*/}
  case "$w" in
    claude|codex|copilot)   case " $c " in *' -p '*|*' --print '*|*' --prompt '*|*' exec '*) return 1;; esac; return 0;;
    bash|sh|zsh|fish|dash|ash|node|python|python3|irb) case " $c " in *' -c '*|*' -e '*) return 1;; esac; return 0;;
  esac
  return 1; }
# Open a FRESH session (ab-<box>-<folder>-<rand>) running box <name> here (survives ssh drop / app switch).
# Always new — each launch gets its own; a random suffix keeps same-folder launches distinct. Reattach with 'ab session'.
# A `host-*` name opens a plain HOST shell (no box, no proot) — still an ab-* session so it lists/kills/wakelocks the same.
sessrun(){ local prof="$1"; shift; local s base
  needtmux || return 1
  hostheal                                                       # install the host-shell terminal self-heal (idempotent)
  [ "${prof#host-}" = "$prof" ] && { selfok || return 1; }      # box pane re-runs $SELF; host pane doesn't, so skip the parse gate
  [ "$(wakestat)" = on ] || wakeon || true
  base="ab-$(slug "$prof")-$(slug "$PWD")"
  s="$base-$(printf '%04d' "$((RANDOM % 10000))")"
  while tmux has-session -t "=$s" 2>/dev/null; do s="$base-$(printf '%04d' "$((RANDOM % 10000))")"; done
  case "$prof" in
    host-*) [ "$#" -gt 0 ] && tmux new -s "$s" -c "$PWD" "${SHELL:-bash}" -lc "$*" \
                           || tmux new -s "$s" -c "$PWD";;       # no cmd → the default interactive host shell
    *)      tmux new -s "$s" -c "$PWD" bash "$SELF" run "$prof" "$@";;   # 'run' explicitly: a box named like a command (ps, stop…) must not dispatch as one inside the pane
  esac
  anysession || { [ "$(wakestat)" = on ] && wakeoff; }; return 0; }
session(){ local k n; case "${1:-}" in
    ""|ls|list) sesspick;;
    kill) shift
      if [ -n "${1:-}" ]; then n=0
        for k in $(tmux ls -F '#S' 2>/dev/null | grep -E "^(ab-)?$1(-|\$)"); do   # match ab-<name> or a bare <name>
          tmux kill-session -t "=$k" 2>/dev/null && n=$((n+1)); done
        [ "$n" -gt 0 ] && msg "killed $n session(s) for '$1'" "$G" || msg "no session for '$1'" "$Y"
        anysession || { [ "$(wakestat)" = on ] && wakeoff; }
      else sesspick kill; fi;;
    *) sessrun "$@";; esac; }

# ── rclone two-way sync (cwd ⇄ Dropbox) ────────────────────────────
# Under proot/Termux inotify is unreliable → rclone bisync, triggered manually (or a simple watch loop). rclone.conf
# holds the Dropbox token (secret) → kept in $VC, never in the box. Needs rclone >=1.64.
rc(){ rclone --config "$RCONF" "$@"; }
rcsetup(){ has rclone || pkg install -y rclone || return 1
  msg "name the remote '$RREMOTE'; if the phone can't open a browser, run 'rclone authorize dropbox' on a computer and paste the token back" "$Y"
  rc config; }
rcpair(){ printf '%s..%s' "$(printf '%s' "${PWD#/}" | tr '/ ' '__')" "$(printf '%s' "$RREMOTE:$1" | tr ':/ ' '___')"; }
rcok(){ [ -z "${AB_RC_YES:-}" ] || return 0   # confirm once per run before syncing this dir (a mistake would sync the whole tree)
  local a; printf 'sync %s ⇄ %s:%s? [y/N] ' "$PWD" "$RREMOTE" "${1:-}"; read -r a
  case "$a" in [Yy]*) AB_RC_YES=1; return 0;; *) return 1;; esac; }
rcsync(){ local p="${1:-}" mark
  [ -n "$p" ] || { msg "usage: ab sync <Dropbox path> [resync] | watch | setup | remove <path> | status" "$R"; return 1; }
  has rclone || rcsetup || return 1
  rc listremotes 2>/dev/null | grep -q "^$RREMOTE:" || { msg "'$RREMOTE:' remote not configured — run 'ab sync setup' first" "$R"; return 1; }
  p="${p#"$HOME"/}"; p="${p#/}"; p="${p#"$RREMOTE":}"   # a ~/… path expands to $HOME/… in the shell → always treat as a Dropbox path
  [ -n "$p" ] || { msg "Dropbox path cannot be the root" "$R"; return 1; }
  rcok "$p" || return 1
  [ -f "$RFILTER" ] || printf -- '- node_modules/**\n- .venv/**\n- __pycache__/**\n- .DS_Store\n' > "$RFILTER"
  mark="$STATE/bisync/$(rcpair "$p").ok"; mkdir -p "$STATE/bisync"
  local flags=(--config "$RCONF" --filters-file "$RFILTER" --conflict-resolve newer \
    --resilient --recover --max-lock 2m --workdir "$STATE/bisync" -v)
  if [ ! -f "$mark" ] || [ "${2:-}" = resync ] || [ "${2:-}" = --resync ]; then flags+=(--resync); fi
  rc mkdir "$RREMOTE:$p" 2>/dev/null
  local blog="$STATE/bisync/.last.log" brc=0
  rclone bisync "$PWD" "$RREMOTE:$p" "${flags[@]}" 2>&1 | tee "$blog"; brc=${PIPESTATUS[0]}
  if [ "$brc" -ne 0 ]; then
    if grep -q -- '--resync' "$blog" && [[ " ${flags[*]} " != *" --resync "* ]]; then
      msg "sync state broken — auto --resync to rebuild the baseline and retry once" "$Y"
      rclone bisync "$PWD" "$RREMOTE:$p" "${flags[@]}" --resync \
        || { msg "bisync failed (even with --resync) — see output above" "$R"; return 1; }
    else msg "bisync failed — see output above; force a rebuild with: ab sync $p resync" "$R"; return 1; fi
  fi
  printf '%s ⇄ %s:%s\n' "$(short "$PWD")" "$RREMOTE" "$p" > "$mark"
  msg "sync done: $(short "$PWD") ⇄ $RREMOTE:$p" "$G"; }
rcstatus(){ local f n=0 w
  for f in "$STATE/bisync"/*.ok; do [ -e "$f" ] || break; n=$((n+1))
    if [ -s "$f" ]; then printf '  %s' "$(cat "$f")"; else printf '  %s' "$(basename "$f" .ok)"; fi
    printf '  (last: %s)\n' "$(date -r "$f" '+%m-%d %H:%M')"; done
  w=$(tmux ls -F '#S' 2>/dev/null | grep '^ab-sync-' | sed 's/^ab-sync-/  watching: /')
  [ -n "$w" ] && printf '%s\n' "$w"
  [ "$n" -eq 0 ] && msg "no sync pairs — create one: ab sync <Dropbox path>" "$Y"; return 0; }
rcremove(){ local p="${1:-}" base rkey f n=0
  [ -n "$p" ] || { msg "usage: ab sync remove <Dropbox path>" "$Y"; return 1; }
  p="${p#"$HOME"/}"; p="${p#/}"; p="${p#"$RREMOTE":}"   # accept ~/…, /…, or dropbox:… forms
  base="$STATE/bisync/$(rcpair "$p")"                    # 1) exact pair for THIS folder
  if ls "$base".* >/dev/null 2>&1; then rm -f "$base".*
    msg "pair state deleted: $(short "$PWD") ⇄ $RREMOTE:$p (next sync auto-resyncs)" "$G"; return 0; fi
  rkey=$(printf '%s' "$RREMOTE:$p" | tr ':/ ' '___')     # 2) else match the remote path in whatever folder made it
  for f in "$STATE/bisync/"*"..$rkey.ok"; do [ -e "$f" ] || continue
    if [ -s "$f" ]; then msg "removed $(cat "$f") (next sync auto-resyncs)" "$G"; else msg "removed $(basename "$f" .ok)" "$G"; fi
    rm -f "${f%.ok}".*; n=$((n+1)); done
  [ "$n" -gt 0 ] || { msg "no state for $RREMOTE:$p in any folder — see 'ab sync' for the exact pairs" "$Y"; return 1; }
  return 0; }
# Emit "localdir<TAB>remotepath" for every recorded pair, parsed from each .ok mark's stored "~/local ⇄ dropbox:remote".
rcpairs(){ local f line l r
  for f in "$STATE/bisync"/*.ok; do [ -s "$f" ] || continue
    line=$(head -1 "$f"); case "$line" in *" ⇄ "*) :;; *) continue;; esac
    l=${line%% ⇄ *}; r=${line##* ⇄ }; l="${l/#\~/$HOME}"; r="${r#*:}"   # ~→$HOME, strip "dropbox:"
    [ -n "$l" ] && [ -n "$r" ] && printf '%s\t%s\n' "$l" "$r"; done; }
# Sync every recorded pair once, each from its own local dir. AB_RC_YES must already be set (the loop/caller confirms first).
rcsyncall(){ local l r n=0 rc=0
  while IFS=$'\t' read -r l r; do
    [ -d "$l" ] || { msg "skip: $(short "$l") no longer exists (ab sync remove $r)" "$Y"; continue; }
    n=$((n+1)); msg "── $(short "$l") ⇄ $RREMOTE:$r ──" "$CY"
    ( cd "$l" && rcsync "$r" ) || rc=1
  done < <(rcpairs)
  [ "$n" -gt 0 ] || { msg "no sync pairs — create one: ab sync <Dropbox path>" "$Y"; return 1; }
  return "$rc"; }
# Minimal watch: open a host tmux session (ab-sync-<x>) looping bisync in the background. Attach/kill via ab session.
# No path → watch every recorded pair in one 'sync-all' session.
rcwatch(){ local s=300 p="" name
  while [ $# -gt 0 ]; do case "$1" in ''|*[!0-9]*) p="$1";; *) s="$1";; esac; shift; done
  [ "$s" -ge 10 ] 2>/dev/null || { msg "minimum interval 10s (each round hits the Dropbox API several times)" "$R"; return 1; }
  if [ -z "$p" ]; then                          # watch-all
    local pairs; pairs=$(rcpairs)
    [ -n "$pairs" ] || { msg "no sync pairs to watch — create one first: ab sync <Dropbox path>" "$R"; return 1; }
    printf '%s\n' "$pairs" | while IFS=$'\t' read -r l r; do printf '  %s ⇄ %s:%s\n' "$(short "$l")" "$RREMOTE" "$r"; done
    local a; printf 'watch all the above every %ss? [y/N] ' "$s"; read -r a
    case "$a" in [Yy]*) :;; *) return 1;; esac
    needtmux || return 1; selfok || return 1
    name="ab-sync-all"
    tmux has-session -t "=$name" 2>/dev/null && { msg "already watching all — attach: ab session; stop: ab session kill sync-all" "$Y"; return 0; }
    [ "$(wakestat)" = on ] || wakeon || true
    tmux new -ds "$name" bash "$SELF" sync watch-run-all "$s"
    msg "watching all pairs every ${s}s (session sync-all); stop: ab session kill sync-all" "$G"; return 0; fi
  rcok "$p" || return 1; needtmux || return 1; selfok || return 1
  name="ab-sync-$(printf '%s' "${p##*/}" | tr -c 'A-Za-z0-9_.-' '_')"
  tmux has-session -t "=$name" 2>/dev/null && { msg "already watching — attach: ab session; stop: ab session kill ${name#ab-}" "$Y"; return 0; }
  [ "$(wakestat)" = on ] || wakeon || true
  tmux new -ds "$name" -c "$PWD" bash "$SELF" sync watch-run "$s" "$p"
  msg "watching $RREMOTE:$p every ${s}s (session ${name#ab-}); stop: ab session kill ${name#ab-}" "$G"; }
rcwatchrun(){ local s="$1" p="$2"; AB_RC_YES=1   # internal: the loop run inside the session pane
  while :; do rcsync "$p" || msg "this round failed, retrying in ${s}s" "$Y"; sleep "$s"; done; }
rcwatchrunall(){ local s="$1"; AB_RC_YES=1        # internal: the sync-all loop run inside the session pane
  while :; do rcsyncall || msg "some pairs failed this round, retrying in ${s}s" "$Y"; sleep "$s"; done; }

# ── Command links (agentbox / ab on PATH) ──────────────────────────
bindir(){ echo "$PREFIX/bin"; }
link(){ local b n; b=$(bindir); mkdir -p "$b"
  chmod +x "$SELF" 2>/dev/null
  has ab && [ "$(command -v ab 2>/dev/null)" != "$b/ab" ] \
    && msg "note: 'ab' already resolves to $(command -v ab) (apache bench?); the agentbox 'ab' link may shadow it depending on PATH order" "$Y"
  for n in agentbox ab; do ln -sf "$SELF" "$b/$n"; done
  msg "linked $b/{agentbox,ab} → $SELF" "$G"; }
# True when both ab + agentbox already point at this script — lets the guided-setup links step auto-skip.
linked(){ local b; b=$(bindir); [ "$(readlink -f "$b/ab" 2>/dev/null)" = "$SELF" ] && [ "$(readlink -f "$b/agentbox" 2>/dev/null)" = "$SELF" ]; }

# ── First-time phone setup (font / extra-keys / sshd / unkill) ─────
# Terminal font: without a custom font Termux lacks powerline/box glyphs and renders the extra-key labels as tofu.
FURL="${AGENTBOX_FONT_URL:-https://github.com/romkatv/powerlevel10k-media/raw/master/MesloLGS%20NF%20Regular.ttf}"
fontinstall(){ [ "${AGENTBOX_FONT_URL:-}" = none ] && return 0
  local f=~/.termux/font.ttf tmp; mkdir -p ~/.termux
  [ -f "$f" ] && [ ! -f "$f.bak" ] && cp "$f" "$f.bak"
  tmp=$(mktemp) || return 0
  msg "installing terminal font…" "$G"
  if { has curl && curl -fsSL "$FURL" -o "$tmp"; } || { has wget && wget -qO "$tmp" "$FURL"; }; then
    if [ "$(wc -c < "$tmp" 2>/dev/null || echo 0)" -ge 20000 ]; then
      mv "$tmp" "$f"; has termux-reload-settings && termux-reload-settings
      msg "font installed → $f (override: AGENTBOX_FONT_URL=<ttf url>, skip: AGENTBOX_FONT_URL=none)" "$G"
    else msg "font download looks invalid (too small) — keeping the current font" "$Y"; rm -f "$tmp"; fi
  else msg "font download failed — keeping the current font" "$Y"; rm -f "$tmp"; fi; }
# Extra-keys row, tuned for a TUI agent inside tmux: ⇧⇥ (Claude Code mode cycle), ⏎↵ (newline, no submit), ^C, tmux
# detach + scroll, and HOME/END/PGUP/PGDN folded onto arrow long-press. Managed block; backs the original up once.
termuxprops(){ [ "${AGENTBOX_EXTRA_KEYS:-}" = none ] && return 0
  local f=~/.termux/termux.properties; mkdir -p ~/.termux
  [ -f "$f" ] && [ ! -f "$f.bak" ] && cp "$f" "$f.bak"
  [ -f "$f" ] && sed -i '/#AGENTBOX-EXTRA-KEYS/,$d' "$f" 2>/dev/null
  if [ -n "${AGENTBOX_EXTRA_KEYS:-}" ]; then
    { printf '#AGENTBOX-EXTRA-KEYS (managed)\n'; printf 'extra-keys = %s\n' "$AGENTBOX_EXTRA_KEYS"; } >> "$f"
  else
    cat >> "$f" <<'EOF'
#AGENTBOX-EXTRA-KEYS (managed — re-run `ab setup` to refresh; edit ABOVE this line to keep changes)
# Tuned for driving a TUI agent inside tmux from a phone. Every key that left this row is still here as a LONG-PRESS:
#   / → ~    - → |    ↑ → PGUP    ↓ → PGDN    ← → HOME    → → END
# Macro keys (one tap instead of a 3-tap chord through the sticky CTRL toggle):
#   ⇧⇥   Shift+Tab   cycles Claude Code modes (normal / auto-accept / plan)
#   ⏎↵   \ + Enter   newline WITHOUT submitting — multi-line prompts
#   ^C   Ctrl-C      interrupt
#   hide Ctrl-b d    detach the tmux session (ab session reattaches)
#   copy Ctrl-b [    tmux copy-mode: scroll back with the arrows (this config runs 'mouse off')
# CTRL/ALT/ESC each appear exactly ONCE as a standalone key — Termux misbehaves when a 'special key' is listed twice.
extra-keys = [[ \
  ESC, TAB, {macro: "SHIFT TAB", display: "⇧⇥"}, CTRL, ALT, {key: UP, popup: PGUP}, {macro: "CTRL c", display: "^C"}, {macro: "CTRL b d", display: "hide"} \
], [ \
  {key: "/", popup: "~"}, {key: "-", popup: "|"}, KEYBOARD, {macro: "BACKSLASH ENTER", display: "⏎↵"}, {key: LEFT, popup: HOME}, {key: DOWN, popup: PGDN}, {key: RIGHT, popup: END}, {macro: "CTRL b [", display: "copy"} \
]]
EOF
  fi
  has termux-reload-settings && termux-reload-settings
  msg "extra-keys deployed → $f  (⇧⇥ modes · ⏎↵ newline · ^C · hide = detach · copy = copy-mode/scroll; long-press an arrow for HOME/END/PGUP/PGDN; original at $f.bak)" "$G"; }
# sshd: Termux is single-user and accepts any username; password auth stays on only until a key is enrolled, then key-only.
sshauth(){ local sc="$PREFIX/etc/ssh/sshd_config" pa=yes
  grep -Eq '^[^#[:space:]]' ~/.ssh/authorized_keys 2>/dev/null && pa=no
  if grep -Eq '^[# ]*PasswordAuthentication' "$sc"; then
    sed -i -E "s/^[# ]*PasswordAuthentication.*/PasswordAuthentication $pa/" "$sc"
  else echo "PasswordAuthentication $pa" >> "$sc"; fi
  if [ "$pa" = no ]; then msg "ssh key enrolled — password login off (key-only)" "$G"
  else msg "no ssh key enrolled yet — password login on; from the computer: ssh-copy-id -p 8022 <phone-ip>" "$Y"; fi; }
# Phone side: font → extra-keys → mirror → upgrade → sshd (8022) → wakelock → link.
initphone(){ fontinstall; termuxprops; hostheal
  has termux-reload-settings && termux-reload-settings
  if [ -t 0 ]; then termux-change-repo; else msg "non-interactive — skipping termux-change-repo" "$Y"; fi
  pkg update -y || return 1
  pkg upgrade -y -o Dpkg::Options::=--force-confold || return 1
  # termux-api = the CLI half of the phone bridge (battery · notification · clipboard · toast · share · location).
  # The other half is the Termux:API APK, which apt cannot install — see the note printed below.
  pkg install -y openssh termux-services iproute2 procps proot-distro termux-api || return 1
  msg "termux-api installed (battery · notification · clipboard · toast). The CLI is only half of it: the Termux:API APP must also be installed, from the SAME source as Termux (F-Droid or Play — a mixed pair is signature-blocked), or every termux-* call fails." "$Y"
  mkdir -p ~/.ssh && chmod 700 ~/.ssh
  touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys
  sshauth
  [ -e ~/.termux_authinfo ] || { msg "set an SSH login password:" "$G"; passwd; }
  rm -f "$PREFIX/var/service/sshd/down"
  pgrep -x sshd >/dev/null || sshd
  wakeon || true
  link
  echo; msg "Done — sshd is on port 8022" "$G"
  kv "user" "$(whoami)"
  local ips; ips=$(lanips)
  kv "  ip" "${ips:-<unknown — check the phone Wi-Fi settings>}"
  msg "connect from a computer: ssh -p 8022 $(whoami)@<the ip above>" "$G"; return 0; }
# Stop Android 12+ from killing the box's background processes (the "phantom process" monitor), on-device via Termux's
# own adb over Wireless Debugging — no computer needed. Guided, since the ports change each time.
unkill(){ local t="${AGENTBOX_TTY:-/dev/tty}" pport cport code v
  has adb || { msg "installing android-tools (adb)…" "$G"; pkg install -y android-tools || { msg "couldn't install android-tools (adb)" "$R"; return 1; }; }
  msg "Stop Android 12+ from killing the box's background processes (the 'phantom process' killer)." "$G"
  msg "Runs on-device via Termux's own adb over Wireless Debugging — no computer needed." "$G"
  { printf '\n'
    printf '  1) Enable Developer options: Settings > About phone > tap "Build number" 7x.\n'
    printf '  2) Settings > System > Developer options > turn ON "Wireless debugging" (keep the screen open).\n'
    printf '  3) Tap "Pair device with pairing code" — it shows an IP:PORT and a 6-digit code.\n'; } > "$t"
  printf '     pairing PORT (the number after the colon): ' > "$t"; IFS= read -r pport < "$t"
  printf '     pairing CODE (6 digits): '                  > "$t"; IFS= read -r code  < "$t"
  if [ -n "$pport" ] && [ -n "$code" ]; then adb pair "localhost:$pport" "$code" 2>&1 | sed 's/^/     /'
  else msg "  (skipped pairing — required on the first run for Android 11+)" "$Y"; fi
  printf '  4) On the MAIN Wireless debugging screen it shows IP:PORT (a DIFFERENT port than pairing).\n' > "$t"
  printf '     connect PORT (the number after the colon): ' > "$t"; IFS= read -r cport < "$t"
  [ -n "$cport" ] && adb connect "localhost:$cport" 2>&1 | sed 's/^/     /'
  adb devices 2>/dev/null | grep -q 'device$' || { msg "adb didn't connect — the ports change every time; re-check and retry: ab setup" "$R"; return 1; }
  msg "connected — applying the phantom-process-killer disable…" "$G"
  adb shell "/system/bin/device_config set_sync_disabled_for_tests persistent"                2>&1 | sed 's/^/     /'
  adb shell "/system/bin/device_config put activity_manager max_phantom_processes 2147483647" 2>&1 | sed 's/^/     /'
  adb shell "settings put global settings_enable_monitor_phantom_procs false"                 2>&1 | sed 's/^/     /'
  v=$(adb shell "/system/bin/device_config get activity_manager max_phantom_processes" 2>/dev/null | tr -d '\r')
  adb disconnect >/dev/null 2>&1
  msg "done — max_phantom_processes = ${v:-set}. Android won't kill the box's background processes now." "$G"
  msg "some ROMs reset this after a reboot/OTA — re-run 'ab setup' (unkill step) if the box starts dying." "$Y"; }
# ── Guided first-time setup (ab setup) — bootstrap the tool + edit tokens (env folded in) ──
setup(){ local t="${AGENTBOX_TTY:-/dev/tty}" ans i=0 tot cmd title why rest s; local -a steps
  steps=(
    "links|put agentbox on PATH|Creates the ab / agentbox commands in \$PREFIX/bin (only runs if they're missing)."
    "init|set up Termux|Glyph font + extra-keys row (⇧⇥ · ⏎↵ · ^C · tmux detach/scroll), updates Termux, installs proot-distro + termux-api (battery · notification · clipboard), starts sshd on 8022, and self-heals the host shell after an ssh drop (no more mouse-code spill)."
    "tmux|tmux config|Applies the managed tmux config (mouse off + TUI-friendly keys)."
    "unkill|stop Android killing the box|Disables the phantom-process killer via on-device adb (Android 12+, guided)."
    "env|add your API tokens|You'll be asked for each token in turn; press Enter to leave one unchanged."
  )
  tot=${#steps[@]}
  msg "agentbox guided setup ($tot steps) — each is explained and asked before it runs (Ctrl-C quits any time)" "$G"
  for s in "${steps[@]}"; do
    i=$((i+1)); cmd="${s%%|*}"; rest="${s#*|}"; title="${rest%%|*}"; why="${rest#*|}"
    printf '\n' > "$t"; msg "Step $i of $tot — $title" "$G"
    if [ "$cmd" = links ] && linked; then msg "  already on PATH → skipping (the installer and 'set up Termux' both link)" "$Y"; continue; fi
    printf '%s\n' "$why" > "$t"
    printf 'Enter = run;  n = skip: ' > "$t"
    IFS= read -r ans < "$t" || ans=n
    case "$ans" in [Nn]*) msg "skipped — re-run any time: ab setup" "$Y"; continue;; esac
    case "$cmd" in
      init) initphone;; tmux) { needtmux && tmuxconf force; } || true;; unkill) unkill || true;;
      links) link || true;; env) mkenv; envedit;;
    esac || { msg "step '$cmd' didn't finish cleanly — fix the issue above, then re-run: ab setup" "$R"; return 1; }
  done
  printf '\n' > "$t"; msg "setup complete — try: ab claude   (scopes claude to the current folder)" "$G"; }

# ── Update (re-run the installer) ──────────────────────────────────
# Just re-runs install.sh from AGBASE (which itself re-fetches the agentbox script + templates). raw.githubusercontent.com
# may cache the branch URL for up to ~5 min, so an update right after a fresh push can briefly lag — re-run it if so.
update(){ { has curl || has wget; } || { msg "need curl or wget to update" "$R"; return 1; }
  msg "re-running the installer ($AGBASE/install.sh)…" "$Y"
  # AGENTBOX_SKIP_SETUP=1 → refresh code+templates only; skip the guided setup (run 'ab setup' to reconfigure).
  if has curl; then curl -fsSL "$AGBASE/install.sh" | AGENTBOX_BASE="$AGBASE" AGENTBOX_SKIP_SETUP=1 bash
  else wget -qO- "$AGBASE/install.sh" | AGENTBOX_BASE="$AGBASE" AGENTBOX_SKIP_SETUP=1 bash; fi; }

# ── Help screen ────────────────────────────────────────────────────
# Colour language (shared with boxls): BD = the literal command you type, Y = an arg you supply,
# CY·BD = section header, G = reserved for status ("built"/"ready"), DM = notes. WIDE (set in usage,
# visible here via bash dynamic scope) picks a 2-column layout on wide terminals and a stacked one on
# a narrow phone screen so descriptions get a clean hang-indent instead of wrapping to column 0.
row(){ local n c1="$BD"; case "$1" in '<'*|'['*) c1="$Y";; esac   # a <placeholder>/[arg] name isn't a literal command → yellow
  if [ "${WIDE:-1}" = 1 ]; then n=$((30-$(dw "$1${2:+ $2}"))); ((n<1)) && n=1
    printf '  %s%s%s%s%*s%s\n' "$c1" "$1" "${2:+ $Y$2}" "$Z" "$n" '' "$(wrap 32 "$3")"
  elif [ -z "$1$2" ]; then printf '      %s\n' "$(wrap 6 "$3")"   # continuation line (empty command)
  else printf '  %s%s%s%s\n      %s\n' "$c1" "$1" "${2:+ $Y$2}" "$Z" "$(wrap 6 "$3")"; fi; }
hd(){ printf '\n%s%s%s' "$CY$BD" "$1" "$Z"
  [ -n "${2:-}" ] && { [ "${WIDE:-1}" = 1 ] && printf '  %s%s%s' "$DM" "$(wrap $(( $(dw "$1") + 4 )) "$2")" "$Z" \
                                            || printf '\n  %s%s%s' "$DM" "$(wrap 2 "$2")" "$Z"; }
  printf '\n'; }
# Note bullet (▍Notes): dim "· label  text", label padded so the text column lines up. These run long by design —
# each is a whole rule — so the text is wrapped under its own column (narrow screens put it below the label).
nt(){ if [ "${WIDE:-1}" = 1 ]; then printf '  %s· %-8s %s%s\n' "$DM" "$1" "$(wrap 13 "$2")" "$Z"
  else printf '  %s· %s\n    %s%s\n' "$DM" "$1" "$(wrap 4 "$2")" "$Z"; fi; }
usage(){
  local WIDE=1 cols withstatus="${1:-}"; cols=$(tput cols 2>/dev/null || echo "${COLUMNS:-80}"); [ "$cols" -ge 1 ] 2>/dev/null || cols=80
  [ "$cols" -lt 72 ] && WIDE=0
  if [ "$WIDE" = 1 ]; then                                       # banner + a 2-line usage (tool commands / box run)
    printf '%s %s\n' "${BD}agentbox${Z}" "${DM}v$VERSION — throwaway, folder-scoped AI-agent boxes (Termux + proot-distro · $DIST)${Z}"
    printf '%susage:%s  ab <command> [args]\n' "$DM" "$Z"
    printf '        ab <name> [cmd]   %srun a box scoped to this folder%s\n' "$DM" "$Z"
  else
    printf '%s %s\n' "${BD}agentbox${Z}" "${DM}v$VERSION · $DIST${Z}"
    printf 'ab <command> [args]\nab <name> [cmd]  %s(a box)%s\n' "$DM" "$Z"
  fi
  [ "$withstatus" = full ] && { printf '\n'; boxls; }            # bare `ab` shows current boxes/templates/snapshots here
  hd "▍Boxes"
  row run     "<name> [cmd]" "build+run a box scoped to this folder — runs cmd (else RUN); builds if missing"
  row "<name>" "[cmd]"    "  shorthand for 'ab run <name>' (any name that isn't a reserved command below)"
  row "" ""               "  cmd replaces the profile's RUN — 'ab <name> bash' = a shell in the box, agent installed"
  row "" ""               "  a cmd that starts with a flag ADDS to RUN instead — 'ab claude --continue' (not 'claude claude --continue')"
  row "" ""               "  no cmd, or a cmd you sit in → a fresh tmux session (survives ssh-drop; see ▍Sessions)"
  row save    "<name>"    "golden snapshot of that box's rootfs"
  row restore "<name>"    "restore that box from its snapshot"
  row remove  "<name>"    "delete the box rootfs + snapshot (alias: rm; also asks about the profile conf)"
  row rebuild "<name>"    "force-rebuild the box from its profile — wipes + reinstalls (keeps the snapshot)"
  row upgrade "<name>"    "update a built box's apt + agent packages IN PLACE — no rebuild, no re-download"
  row stop    ""          "close the running box desktop — keeps the box (ab remove = delete + rebuild)"
  row ps      "[kill]"    "what agentbox is running NOW — CPU per box + battery verdict; kill clears strays"
  row "pw <name>" "[password]" "set/show a desktop box's login password (else it's random each launch)"
  row "pkg <name>" "[add|rm|search]" "search the box's apt catalog — then offers to add + 'ab upgrade' it; add/rm edit PKGS"
  hd "▍Sessions" "(interactive 'ab <name>' / 'ab <name> bash' opens a fresh one each launch; auto wakelock)"
  row session "[name]"    "no arg = list EVERY tmux session to reattach/kill"
  row "" ""               "  name = open a new session here (host-* → a host shell, not a box)"
  row "session kill" "[name]" "kill a session (no name = pick; wakelock frees when all end)"
  hd "▍Sync" "(rclone bisync, manual trigger)"
  row sync    "[path]"    "sync cwd ⇄ ${RREMOTE}:<path> (no arg = status)"
  row "sync setup" ""     "install rclone + configure the remote"
  row "sync watch" "[sec] [path]" "loop-sync in a background session (default 300s; no path = all pairs)"
  row "sync remove" "[path]" "delete a pair's sync state"
  hd "▍Tool"
  row setup   ""          "guided bootstrap — links · font · keys · tmux · unkill · proot · tokens"
  row update  ""          "update agentbox itself — code + templates (NOT box packages; see 'ab upgrade')"
  row help    ""          "show this help screen"
  row version ""          "print the agentbox version"
  hd "▍Templates" "ab <name> creates a box from one; your edits then live in $(short "$VC")"
  local tf; for tf in "$TPL"/*.conf; do [ -e "$tf" ] || { row "" "" "(none installed — run ab update)"; break; }
    row "$(printf '%-7s' "$(basename "$tf" .conf)")" "v$(tplver "$tf")" "$(tpldesc "$tf")"
  done
  hd "▍Notes"
  nt profile  "$(short "$VC")/profile/<name>.conf — AGENT · PKGS · TOKENS · RUN · MOUNT · EPHEMERAL · DESKTOP · APP · MITM · LAN · RFB · GPU · DIST  (docker: set INSTALL='…')"   # spaced so it wraps: one long unbreakable token overflows a phone screen
  nt new      "a name with no profile yet asks before creating the box — Enter = yes, n = cancel (AB_YES=1 skips the ask)"
  nt shell    "'ab <name> bash' opens a shell in the box instead of its RUN — the agent is installed, just not started (there is no separate 'shell box' template; this is it)"
  nt flags    "'ab <name> --flag …' adds the flags to RUN instead of replacing it: 'ab claude --continue' runs 'claude --continue' in the box"
  nt session  "a session is opened for RUN (flags or not) and for a cmd you sit in — a shell, an agent, a REPL; anything else runs in the foreground so its output survives the pane, as does a one-shot form of those ('claude -p …', 'bash -c …'). AB_SESSION=1 forces one, AB_NO_SESSION=1 never"
  nt desktop  "DESKTOP=xfce (minimal session + wm) or kde (full KDE Plasma — fancy, ~2 GB build); both serve the same KasmVNC desktop on $GUI_BOXWEB"
  nt gpu      "GPU=virgl (desktop boxes) renders GL on the phone's GPU via a Termux-side server — opt-in, CPU if unavailable"
  nt rfb      "RFB=1 (desktop boxes) also serves the SAME desktop as plain VNC on $GUI_BOXRFB — for a native viewer with a trackpad mode (AVNC · bVNC); the browser client is touch-absolute"
  nt tokens   "$(short "$ENVF")  (0600; only a profile's TOKENS keys are injected; AGENTBOX_* excluded)"
  nt reserved "run save restore remove rm rebuild upgrade stop ps pw pkg setup update sync session help version ls list"
  nt shadow   "a box whose name is a reserved word runs only via 'ab run <name>' — the 'ab <name>' shorthand is taken"
  nt battery  "a desktop's Xvnc/chromium/dbus are daemonised — end its session WITHOUT 'ab stop' and they outlive it, holding a core with the screen off; 'ab ps' finds them, 'ab ps kill' clears them"
  nt network  "shares the phone network — for a different exit IP use a whole-device Android VPN app"
  return 0
}

# ── Command dispatch ───────────────────────────────────────────────
migrateconf   # move any pre-3.13 $VC/box-<name>.conf profiles into $VC/profile/ (no-op once done)
case "${1:-}" in
  "") usage full;;                                # bare ab → banner + current boxes + help
  ls|list) boxls;;
  run)     shift; if [ -n "${1:-}" ]; then abox "$@"; else msg "which box? ab run <name>  (shorthand: ab <name>)" "$Y"; fi;;
  save)    shift; boxsave "$@";;
  restore) shift; boxrestore "$@";;
  remove|rm) shift; boxremove "$@";;
  rebuild) shift; if [ -n "${1:-}" ]; then aboxbuild "$1" force; else msg "which box? ab rebuild <name>" "$Y"; fi;;
  upgrade) shift; boxupgrade "$@";;
  stop)    boxstop;;                              # close the running box desktop (keeps the box; ab remove = delete + rebuild)
  ps)      shift; abps "$@";;                     # what agentbox has running right now, what it costs, how to stop it
  pw)      shift; abpw "$@";;                      # set/show a desktop box's login password
  pkg)     shift; abpkg "$@";;
  setup)   setup;;
  update)  update;;
  sync) shift; case "${1:-}" in
      setup) rcsetup;;
      remove) shift; rcremove "$@";;
      watch) shift; rcwatch "$@";;
      watch-run) shift; rcwatchrun "$@";;         # internal: the loop run inside a session pane
      watch-run-all) shift; rcwatchrunall "$@";;  # internal: the sync-all loop run inside a session pane
      ""|status) rcstatus;;
      *) rcsync "$@";; esac;;
  session) shift; session "$@";;
  help|-h|--help) usage;;
  version|-v|--version) printf 'agentbox v%s\n' "$VERSION";;
  *) abox "$@";;                                  # ab <name> [cmd] — build+run a box scoped to the cwd
esac
